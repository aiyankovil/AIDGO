# Proposed rules for https://github.com/perma-id/w3id.org/tree/master/aidgo/.htaccess
# Maintainer: Kuruvilla George Aiyankovil (GitHub: aiyankovil)
# Assumes GitHub Pages serves this repository at https://aiyankovil.github.io/AIDGO/
# - check the Pages URL before opening the pull request to perma-id/w3id.org.

Options +FollowSymLinks
RewriteEngine on

# Turtle (ontology + knowledge graph)
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/x-turtle
RewriteRule ^$ https://aiyankovil.github.io/AIDGO/output/aidgo_kg.ttl [R=303,L]

# N-Triples
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^$ https://aiyankovil.github.io/AIDGO/output/aidgo_kg.nt [R=303,L]

# Ontology only (TBox)
RewriteRule ^ontology$ https://aiyankovil.github.io/AIDGO/ontology/aidgo.ttl [R=303,L]
# Versioned IRI
RewriteRule ^2\.0\.0$ https://raw.githubusercontent.com/aiyankovil/AIDGO/v2.0.0/output/aidgo_kg.ttl [R=303,L]

# Term IRIs (https://w3id.org/aidgo/iso5259#... share the document)
RewriteRule ^iso5259$ https://aiyankovil.github.io/AIDGO/#iso-requirements [R=303,NE,L]

# Default: HTML documentation
RewriteRule ^$ https://aiyankovil.github.io/AIDGO/ [R=303,L]
RewriteRule ^(.*)$ https://aiyankovil.github.io/AIDGO/$1 [R=303,L]

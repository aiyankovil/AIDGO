aiapr:AiaPrReq_10.1_e1 a aidgo:ObligationElement ;
    skos:definition "the training, validation and testing data sets of a high-risk AI system"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.1_e2 a aidgo:ObligationElement ;
    skos:definition "the data sets used for development meet defined quality criteria"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.1_e3 a aidgo:ObligationElement ;
    skos:definition "the quality criteria are those of Article 10(2) to 10(5) (governance, representativeness, statistical properties, context of use, special-category safeguards)"@en ;
    aidgo:elementRole "condition" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_1_e1 a aidgo:ObligationElement ;
    skos:definition "training, validation and testing data sets"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_1_e2 a aidgo:ObligationElement ;
    skos:definition "the data sets are subject to data governance and management practices"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.2_1_e3 a aidgo:ObligationElement ;
    skos:definition "the practices are appropriate for the intended purpose of the high-risk AI system"@en ;
    aidgo:elementRole "purpose" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_2 a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.2_2" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "[Data governance and management practices shall concern in particular] the relevant design choices."@en ;
    skos:prefLabel "Governance shall concern relevant design choices"@en ;
    aidgo:articleReference "Art. 10(2)(a)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.2_2_e1,
        aiapr:AiaPrReq_10.2_2_e2 .

aiapr:AiaPrReq_10.2_2_e1 a aidgo:ObligationElement ;
    skos:definition "data governance and management practices address the relevant design choices"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.2_2_e2 a aidgo:ObligationElement ;
    skos:definition "design choices of the high-risk AI system that bear on its data (not only the format of the data set)"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_3_e1 a aidgo:ObligationElement ;
    skos:definition "data governance practices address the data collection processes"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.2_3_e2 a aidgo:ObligationElement ;
    skos:definition "the origin (provenance) of the data is recorded and governed"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_3_e3 a aidgo:ObligationElement ;
    skos:definition "for personal data, the original purpose of the data collection is identified"@en ;
    aidgo:elementRole "condition" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_4_e1 a aidgo:ObligationElement ;
    skos:definition "data governance practices address data-preparation processing operations"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.2_4_e2 a aidgo:ObligationElement ;
    skos:definition "the operations covered include annotation and labelling"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_4_e3 a aidgo:ObligationElement ;
    skos:definition "the operations covered include cleaning, updating, enrichment and aggregation"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_5 a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.2_5" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "[Data governance and management practices shall concern in particular] the formulation of assumptions, in particular with respect to the information that the data is supposed to measure and represent."@en ;
    skos:prefLabel "Governance shall concern formulation of assumptions"@en ;
    aidgo:articleReference "Art. 10(2)(d)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.2_5_e1,
        aiapr:AiaPrReq_10.2_5_e2 .

aiapr:AiaPrReq_10.2_5_e1 a aidgo:ObligationElement ;
    skos:definition "assumptions about the data are explicitly formulated"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.2_5_e2 a aidgo:ObligationElement ;
    skos:definition "the assumptions concern the information the data is supposed to measure and represent"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_6 a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.2_6" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "[Data governance and management practices shall concern in particular] an assessment of the availability, quantity and suitability of the data sets that are needed."@en ;
    skos:prefLabel "Governance shall concern assessment of dataset availability and suitability"@en ;
    aidgo:articleReference "Art. 10(2)(e)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.2_6_e1,
        aiapr:AiaPrReq_10.2_6_e2 .

aiapr:AiaPrReq_10.2_6_e1 a aidgo:ObligationElement ;
    skos:definition "an assessment of the data sets that are needed is carried out"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.2_6_e2 a aidgo:ObligationElement ;
    skos:definition "the assessment covers availability, quantity and suitability of the needed data sets"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_7_e1 a aidgo:ObligationElement ;
    skos:definition "the data sets are examined for possible biases"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.2_7_e2 a aidgo:ObligationElement ;
    skos:definition "the examination targets biases likely to affect the health and safety of persons or to have a negative impact on fundamental rights"@en ;
    aidgo:elementRole "purpose" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_7_e3 a aidgo:ObligationElement ;
    skos:definition "the examination targets biases that could lead to discrimination prohibited under Union law"@en ;
    aidgo:elementRole "purpose" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_7_e4 a aidgo:ObligationElement ;
    skos:definition "the examination pays particular attention where outputs influence inputs for future operations (feedback loops)"@en ;
    aidgo:elementRole "condition" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_8 a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.2_8" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "[Data governance and management practices shall concern in particular] the identification of any data gaps or shortcomings, and how those gaps and shortcomings can be addressed."@en ;
    skos:prefLabel "Governance shall concern identification of data gaps and shortcomings"@en ;
    aidgo:articleReference "Art. 10(2)(h)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.2_8_e1,
        aiapr:AiaPrReq_10.2_8_e2,
        aiapr:AiaPrReq_10.2_8_e3 .

aiapr:AiaPrReq_10.2_8_e1 a aidgo:ObligationElement ;
    skos:definition "data gaps or shortcomings are identified"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.2_8_e2 a aidgo:ObligationElement ;
    skos:definition "the gaps or shortcomings are those that prevent compliance with the Regulation"@en ;
    aidgo:elementRole "condition" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.2_8_e3 a aidgo:ObligationElement ;
    skos:definition "it is determined how the gaps and shortcomings can be addressed"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.3_1_e1 a aidgo:ObligationElement ;
    skos:definition "the data sets are relevant and sufficiently representative"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.3_1_e2 a aidgo:ObligationElement ;
    skos:definition "the data sets are, to the best extent possible, free of errors and complete"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.3_1_e3 a aidgo:ObligationElement ;
    skos:definition "these properties are judged in view of the intended purpose of the high-risk AI system"@en ;
    aidgo:elementRole "purpose" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.3_2 a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.3_2" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "Datasets shall have the appropriate statistical properties, including as regards the persons or groups of persons on which the high-risk AI system is intended to be used."@en ;
    skos:prefLabel "Datasets shall have appropriate statistical properties for persons/groups"@en ;
    aidgo:articleReference "Art. 10(3), 2nd sentence" ;
    aidgo:hasElement aiapr:AiaPrReq_10.3_2_e1,
        aiapr:AiaPrReq_10.3_2_e2 .

aiapr:AiaPrReq_10.3_2_e1 a aidgo:ObligationElement ;
    skos:definition "the data sets have appropriate statistical properties"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.3_2_e2 a aidgo:ObligationElement ;
    skos:definition "the statistical properties are appropriate as regards the persons or groups of persons on whom the system is intended to be used"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.4 a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.4" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "Datasets shall take into account the characteristics particular to the geographical, contextual, behavioural or functional setting of intended use."@en ;
    skos:prefLabel "Datasets shall account for characteristics of the deployment setting"@en ;
    aidgo:articleReference "Art. 10(4)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.4_e1,
        aiapr:AiaPrReq_10.4_e2,
        aiapr:AiaPrReq_10.4_e3 .

aiapr:AiaPrReq_10.4_e1 a aidgo:ObligationElement ;
    skos:definition "the data sets take into account characteristics of the setting of intended use"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.4_e2 a aidgo:ObligationElement ;
    skos:definition "the characteristics are specific to the geographical, contextual, behavioural or functional setting"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.4_e3 a aidgo:ObligationElement ;
    skos:definition "the extent is that required by the intended purpose"@en ;
    aidgo:elementRole "condition" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.5 a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.5" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "Providers may process special categories of personal data strictly necessary for bias detection, subject to appropriate safeguards."@en ;
    skos:prefLabel "Special categories personal data may be processed for bias detection"@en ;
    aidgo:articleReference "Art. 10(5)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.5_e1,
        aiapr:AiaPrReq_10.5_e2,
        aiapr:AiaPrReq_10.5_e3,
        aiapr:AiaPrReq_10.5_e4 .

aiapr:AiaPrReq_10.5_a a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.5_a" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "Ensuring bias detection cannot effectively be fulfilled by processing other categories of data, including synthetic or anonymised data."@en ;
    skos:prefLabel "Bias cannot be fulfilled by synthetic/anonymised data alternatives"@en ;
    aidgo:articleReference "Art. 10(5)(a)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.5_a_e1,
        aiapr:AiaPrReq_10.5_a_e2 .

aiapr:AiaPrReq_10.5_a_e1 a aidgo:ObligationElement ;
    skos:definition "it is established that bias detection and correction cannot be effectively fulfilled by processing other data"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.5_a_e2 a aidgo:ObligationElement ;
    skos:definition "the alternatives considered include synthetic or anonymised data"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.5_b a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.5_b" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "Special categories data subject to technical limitations on re-use and state-of-the-art security and privacy-preserving measures."@en ;
    skos:prefLabel "Special data subject to technical limitations and state-of-art security measures"@en ;
    aidgo:articleReference "Art. 10(5)(b)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.5_b_e1,
        aiapr:AiaPrReq_10.5_b_e2,
        aiapr:AiaPrReq_10.5_b_e3 .

aiapr:AiaPrReq_10.5_b_e1 a aidgo:ObligationElement ;
    skos:definition "special categories of personal data used for bias detection"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.5_b_e2 a aidgo:ObligationElement ;
    skos:definition "technical limitations on the re-use of the personal data are applied"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.5_b_e3 a aidgo:ObligationElement ;
    skos:definition "state-of-the-art security and privacy-preserving measures, including pseudonymisation, are applied"@en ;
    aidgo:elementRole "constraint" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.5_e a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.5_e" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "The data shall be deleted once the bias has been corrected or the retention period has expired."@en ;
    skos:prefLabel "Special data deleted when bias corrected or retention period ends"@en ;
    aidgo:articleReference "Art. 10(5)(e)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.5_e_e1,
        aiapr:AiaPrReq_10.5_e_e2,
        aiapr:AiaPrReq_10.5_e_e3 .

aiapr:AiaPrReq_10.5_e1 a aidgo:ObligationElement ;
    skos:definition "special categories of personal data (GDPR Art. 9(1))"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.5_e2 a aidgo:ObligationElement ;
    skos:definition "special-category personal data is processed for the purpose of bias detection and correction"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.5_e3 a aidgo:ObligationElement ;
    skos:definition "the processing is strictly necessary and exceptional"@en ;
    aidgo:elementRole "condition" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.5_e4 a aidgo:ObligationElement ;
    skos:definition "appropriate safeguards for the fundamental rights and freedoms of natural persons apply"@en ;
    aidgo:elementRole "constraint" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.5_e_e1 a aidgo:ObligationElement ;
    skos:definition "special categories of personal data used for bias detection"@en ;
    aidgo:elementRole "object" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.5_e_e2 a aidgo:ObligationElement ;
    skos:definition "the personal data is deleted"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .

aiapr:AiaPrReq_10.5_e_e3 a aidgo:ObligationElement ;
    skos:definition "deletion occurs once the bias has been corrected or the personal data has reached the end of its retention period, whichever comes first"@en ;
    aidgo:elementRole "condition" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.6 a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.6" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "For high-risk AI not using training techniques, paragraphs 2-5 apply only to the testing data sets."@en ;
    skos:prefLabel "For non-training AI, paragraphs 2-5 apply only to testing datasets"@en ;
    aidgo:articleReference "Art. 10(6)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.6_e1,
        aiapr:AiaPrReq_10.6_e2 .

aiapr:AiaPrReq_10.6_e1 a aidgo:ObligationElement ;
    skos:definition "the high-risk AI system is not developed using techniques involving the training of AI models"@en ;
    aidgo:elementRole "condition" ;
    aidgo:isCoreElement false .

aiapr:AiaPrReq_10.6_e2 a aidgo:ObligationElement ;
    skos:definition "the data quality obligations of paragraphs 2 to 5 are applied to the testing data sets"@en ;
    aidgo:elementRole "action" ;
    aidgo:isCoreElement true .


aiapr:AiaPrReq_10.1 a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.1" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "High-risk AI systems shall be developed on the basis of training, validation and testing data sets that meet the quality criteria referred to in paragraphs 2 to 5."@en ;
    skos:prefLabel "High-risk AI systems shall use datasets meeting quality criteria"@en ;
    aidgo:articleReference "Art. 10(1)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.1_e1,
        aiapr:AiaPrReq_10.1_e2,
        aiapr:AiaPrReq_10.1_e3 .

aiapr:AiaPrReq_10.2_1 a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.2_1" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "Training, validation and testing data sets shall be subject to data governance and management practices appropriate for the intended purpose."@en ;
    skos:prefLabel "Datasets shall be subject to appropriate data governance practices"@en ;
    aidgo:articleReference "Art. 10(2)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.2_1_e1,
        aiapr:AiaPrReq_10.2_1_e2,
        aiapr:AiaPrReq_10.2_1_e3 .

aiapr:AiaPrReq_10.2_3 a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.2_3" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "[Data governance and management practices shall concern in particular] data collection processes and the origin of data, and in the case of personal data, the original purpose of the data collection."@en ;
    skos:prefLabel "Governance shall concern data collection processes and origin"@en ;
    aidgo:articleReference "Art. 10(2)(b)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.2_3_e1,
        aiapr:AiaPrReq_10.2_3_e2,
        aiapr:AiaPrReq_10.2_3_e3 .

aiapr:AiaPrReq_10.2_4 a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.2_4" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "[Data governance and management practices shall concern in particular] relevant data-preparation processing operations, such as annotation, labelling, cleaning, updating, enrichment and aggregation."@en ;
    skos:prefLabel "Governance shall concern data-preparation operations"@en ;
    aidgo:articleReference "Art. 10(2)(c)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.2_4_e1,
        aiapr:AiaPrReq_10.2_4_e2,
        aiapr:AiaPrReq_10.2_4_e3 .

aiapr:AiaPrReq_10.2_7 a aidgo:LegalRequirement ;
    dct:identifier "AiaPrReq_10.2_7" ;
    dct:isPartOf aidgo:AIDGO_KG ;
    dct:source <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689> ;
    skos:definition "[Data governance and management practices shall concern in particular] examination in view of possible biases that are likely to affect the health and safety of persons, have a negative impact on fundamental rights or lead to discrimination prohibited under Union law, especially where data outputs influence inputs for future operations."@en ;
    skos:prefLabel "Governance shall concern examination for biases affecting health, safety, rights"@en ;
    aidgo:articleReference "Art. 10(2)(f)" ;
    aidgo:hasElement aiapr:AiaPrReq_10.2_7_e1,
        aiapr:AiaPrReq_10.2_7_e2,
        aiapr:AiaPrReq_10.2_7_e3,
        aiapr:AiaPrReq_10.2_7_e4 .


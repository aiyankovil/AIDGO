aidgo:Map_10.5.b_NoAlignment a aidgo:AlignmentAssertion ;
    dct:identifier "Map_10.5.b_NoAlignment" ;
    prov:generatedAtTime "2026-04-14T00:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo aidgo:KuruvillaGeorgeAiyankovil ;
    prov:wasGeneratedBy aidgo:MappingProcess_v2 ;
    aidgo:alignmentBasis aidgo:GapIdentified ;
    aidgo:alignmentGap "Pseudonymisation, state-of-art security, strict GDPR access controls outside ISO 5259 scope. Recommended: ISO/IEC 27001; ISO/IEC 27701; ENISA AI Cybersecurity Guidelines."@en ;
    aidgo:alignmentJustification "ISO 5259 does not impose pseudonymisation or state-of-art security measures as normative requirements. ISO 5259-4 mentions data privacy conceptually but not at the normative level Art 10(5)(b) requires."@en ;
    aidgo:alignmentType aidgo:NoAlignment ;
    aidgo:coveredCQs "CQ-M3, CQ-M5" ;
    aidgo:legalRequirement aiapr:AiaPrReq_10.5_b ;
    aidgo:technicalRequirement () ;
    aidgo:validationStatus aidgo:ExpertValidated .

aidgo:Map_10.5.e_7.3.8.3 a aidgo:AlignmentAssertion ;
    dct:identifier "Map_10.5.e_7.3.8.3" ;
    prov:generatedAtTime "2026-04-14T00:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo aidgo:KuruvillaGeorgeAiyankovil ;
    prov:wasGeneratedBy aidgo:MappingProcess_v2 ;
    aidgo:alignmentBasis aidgo:FunctionalEquivalence ;
    aidgo:alignmentGap "The legal deletion trigger — bias corrected OR retention period ended — is not addressed by ISO 5259-3."@en ;
    aidgo:alignmentJustification "ISO 5259-3 §7.3.8.3 requires deletion from all storage locations. Gap: ISO does not tie deletion to the legal trigger (bias corrected OR retention period ended)."@en ;
    aidgo:alignmentType aidgo:PartiallySatisfies ;
    aidgo:coveredCQs "CQ-M2, CQ-M5" ;
    aidgo:legalRequirement aiapr:AiaPrReq_10.5_e ;
    aidgo:technicalRequirement iso5259:AidgoReq_7_3_8_3_R1 ;
    aidgo:validationStatus aidgo:ExpertValidated .

aidgo:Map_10.5_NoAlignment a aidgo:AlignmentAssertion ;
    dct:identifier "Map_10.5_NoAlignment" ;
    prov:generatedAtTime "2026-04-14T00:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo aidgo:KuruvillaGeorgeAiyankovil ;
    prov:wasGeneratedBy aidgo:MappingProcess_v2 ;
    aidgo:alignmentBasis aidgo:GapIdentified ;
    aidgo:alignmentGap "Requires GDPR Art.9 + ISO/IEC 27701 compliance. ISO 5259 cannot satisfy this obligation."@en ;
    aidgo:alignmentJustification "ISO 5259 has no provision for special categories of personal data processing. This is a legal obligation under GDPR Article 9 — structurally outside ISO 5259 scope."@en ;
    aidgo:alignmentType aidgo:NoAlignment ;
    aidgo:coveredCQs "CQ-M3, CQ-M5" ;
    aidgo:legalRequirement aiapr:AiaPrReq_10.5 ;
    aidgo:technicalRequirement () ;
    aidgo:validationStatus aidgo:ExpertValidated .

aidgo:Map_10.6_7.3.2.3_R1 a aidgo:AlignmentAssertion ;
    dct:identifier "Map_10.6_7.3.2.3_R1" ;
    prov:generatedAtTime "2026-04-14T00:00:00+00:00"^^xsd:dateTime ;
    prov:wasAttributedTo aidgo:KuruvillaGeorgeAiyankovil ;
    prov:wasGeneratedBy aidgo:MappingProcess_v2 ;
    aidgo:alignmentBasis aidgo:ScopeOverlap ;
    aidgo:alignmentGap "No ISO 5259-3 provision scopes requirements to testing datasets only for non-training AI systems."@en ;
    aidgo:alignmentJustification "ISO 5259-3 §7.3.2.3 covers subset specification including test data. Gap: ISO has no scoping provision limiting requirements to testing datasets only for non-training AI systems."@en ;
    aidgo:alignmentType aidgo:PartiallySatisfies ;
    aidgo:coveredCQs "CQ-M2, CQ-M5" ;

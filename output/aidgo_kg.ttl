    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Documentation shall be intelligible to relevant stakeholders in accordance with their role."@en ;
    skos:prefLabel "Documentation — intelligibility"@en ;
    aidgo:clauseNumber "6.3.7" ;
    aidgo:dqmlcStage aidgo:OrganisationalStage ;
    aidgo:inCollection iso5259:AidgoDocumentationReqColl ;
    aidgo:uses iso5259:stakeholder .

iso5259:AidgoReq_6_3_7_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_6_3_7_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Documentation shall be accessible to relevant stakeholders as appropriate and authorized."@en ;
    skos:prefLabel "Documentation — accessibility"@en ;
    aidgo:clauseNumber "6.3.7" ;
    aidgo:dqmlcStage aidgo:OrganisationalStage ;
    aidgo:inCollection iso5259:AidgoDocumentationReqColl ;
    aidgo:uses iso5259:stakeholder .

iso5259:AidgoReq_6_3_9_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_6_3_9_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Confirmation reviews shall be performed by personnel independent of the activities under review."@en ;
    skos:prefLabel "Confirmation review — independent personnel"@en ;
    aidgo:clauseNumber "6.3.9" ;
    aidgo:dqmlcStage aidgo:OrganisationalStage ;
    aidgo:inCollection iso5259:AidgoConfirmationReviewReqColl .

iso5259:AidgoReq_7_2_1_R1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_2_1_R1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall specify the processes to be performed in each stage of the DQMLC in accordance with the requirements of this document."@en ;
    skos:prefLabel "DQMLC — specify processes"@en ;
    aidgo:clauseNumber "7.2.1" ;
    aidgo:dqmlcStage aidgo:LifeCycleGeneralStage ;
    aidgo:inCollection iso5259:AidgoDQLCReqColl ;
    aidgo:uses iso5259:dataQualityManagementLifeCycle .

iso5259:AidgoReq_7_2_1_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_2_1_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall ensure that each stage of the DQMLC is only entered when all quality gates for the preceding stage have been met."@en ;
    skos:prefLabel "DQMLC — quality gates"@en ;
    aidgo:clauseNumber "7.2.1" ;
    aidgo:dqmlcStage aidgo:LifeCycleGeneralStage ;
    aidgo:inCollection iso5259:AidgoDQLCReqColl ;
    aidgo:uses iso5259:dataQualityManagementLifeCycle .

iso5259:AidgoReq_7_2_1_R3 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_2_1_R3" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall document all deviations from the defined DQMLC together with a justification and any compensating measures."@en ;
    skos:prefLabel "DQMLC — document deviations"@en ;
    aidgo:clauseNumber "7.2.1" ;
    aidgo:dqmlcStage aidgo:LifeCycleGeneralStage ;
    aidgo:inCollection iso5259:AidgoDQLCReqColl ;
    aidgo:uses iso5259:dataQualityManagementLifeCycle .

iso5259:AidgoReq_7_3_4_1_R1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_4_1_R1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall specify data acquisition processes to meet the data specification and include them in the data quality plan."@en ;
    skos:prefLabel "Data acquisition — specify processes"@en ;
    aidgo:clauseNumber "7.3.4.1" ;
    aidgo:dqmlcStage aidgo:AcquisitionStage ;
    aidgo:inCollection iso5259:AidgoDataAcquisitionReqColl ;
    aidgo:uses iso5259:dataAcquisition,
        iso5259:dataQualityPlan,
        iso5259:dataSpecificationDoc .

iso5259:AidgoReq_7_3_4_1_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_4_1_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall monitor data acquisition processes to ensure compliance with the data specification."@en ;
    skos:prefLabel "Data acquisition — monitoring"@en ;
    aidgo:clauseNumber "7.3.4.1" ;
    aidgo:dqmlcStage aidgo:AcquisitionStage ;
    aidgo:inCollection iso5259:AidgoDataAcquisitionReqColl ;
    aidgo:uses iso5259:dataAcquisition,
        iso5259:dataSpecificationDoc .

iso5259:AidgoReq_7_3_4_1_R3 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_4_1_R3" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Risks that arise from incompleteness of the acquired data shall be documented and mitigated."@en ;
    skos:prefLabel "Data acquisition — risk documentation"@en ;
    aidgo:clauseNumber "7.3.4.1" ;
    aidgo:dqmlcStage aidgo:AcquisitionStage ;
    aidgo:inCollection iso5259:AidgoDataAcquisitionReqColl ;
    aidgo:uses iso5259:dataAcquisition .

iso5259:AidgoReq_7_3_4_4_R1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_4_4_R1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall ensure that collected data meets the data specification before progressing to the next DQMLC stage."@en ;
    skos:prefLabel "Data handling — meets specification"@en ;
    aidgo:clauseNumber "7.3.4.4" ;
    aidgo:dqmlcStage aidgo:AcquisitionStage ;
    aidgo:inCollection iso5259:AidgoDataHandlingReqColl ;
    aidgo:uses iso5259:dataQualityManagementLifeCycle,
        iso5259:dataSpecificationDoc .

iso5259:AidgoReq_7_3_4_4_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_4_4_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall specify processes for data handling, including storage, access control, format conversion and integrity checking."@en ;
    skos:prefLabel "Data handling — processes"@en ;
    aidgo:clauseNumber "7.3.4.4" ;
    aidgo:dqmlcStage aidgo:AcquisitionStage ;
    aidgo:inCollection iso5259:AidgoDataHandlingReqColl .

iso5259:AidgoReq_7_3_5_1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_5_1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall specify data preprocessing processes to meet the data specification and include them in the data quality plan."@en ;
    skos:prefLabel "Data preprocessing — specify processes"@en ;
    aidgo:clauseNumber "7.3.5.1" ;
    aidgo:dqmlcStage aidgo:PreprocessingStage ;
    aidgo:inCollection iso5259:AidgoDataPreprocessingReqColl ;
    aidgo:uses iso5259:dataPreprocessing,
        iso5259:dataQualityPlan,
        iso5259:dataSpecificationDoc .

iso5259:AidgoReq_7_3_7_4_R1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_7_4_R1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall monitor the use of provisioned data to detect any degradation of data quality or deviations from the intended use."@en ;
    skos:prefLabel "Tracking — data usage monitoring"@en ;
    aidgo:clauseNumber "7.3.7.4" ;
    aidgo:dqmlcStage aidgo:ProvisioningStage ;
    aidgo:inCollection iso5259:AidgoTrackingImprovementReqColl ;
    aidgo:uses iso5259:dataQuality .

iso5259:AidgoReq_7_3_7_4_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_7_4_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall define and apply corrective actions when deviations or degradation are detected."@en ;
    skos:prefLabel "Tracking — corrective actions"@en ;
    aidgo:clauseNumber "7.3.7.4" ;
    aidgo:dqmlcStage aidgo:ProvisioningStage ;
    aidgo:inCollection iso5259:AidgoTrackingImprovementReqColl .

iso5259:AidgoReq_7_3_7_4_R3 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_7_4_R3" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall use tracking results as feedback to improve data quality planning and acquisition processes."@en ;
    skos:prefLabel "Tracking — improvement feedback"@en ;
    aidgo:clauseNumber "7.3.7.4" ;
    aidgo:dqmlcStage aidgo:ProvisioningStage ;
    aidgo:inCollection iso5259:AidgoTrackingImprovementReqColl ;
    aidgo:uses iso5259:dataQuality .

iso5259:AidgoReq_7_3_7_6_R1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_7_6_R1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall specify the support it will provide for provisioned data, including the duration of support and conditions for termination."@en ;
    skos:prefLabel "Support commitment — specify"@en ;
    aidgo:clauseNumber "7.3.7.6" ;
    aidgo:dqmlcStage aidgo:ProvisioningStage ;
    aidgo:inCollection iso5259:AidgoSupportCommitmentReqColl .

iso5259:AidgoReq_7_3_8_1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_8_1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall choose an appropriate method to decommission the data either through data deletion or through data transfer to a qualified recipient."@en ;
    skos:prefLabel "Data decommissioning — choose method"@en ;
    aidgo:clauseNumber "7.3.8.1" ;
    aidgo:dqmlcStage aidgo:DecommissioningStage ;
    aidgo:inCollection iso5259:AidgoDataDecommissioningReqColl ;
    aidgo:uses iso5259:dataDecommissioning .

iso5259:AidgoReq_7_3_8_1_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_8_1_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall specify data decommissioning processes in the data quality plan, including the schedule and criteria for decommissioning."@en ;
    skos:prefLabel "Data decommissioning — specify processes"@en ;
    aidgo:clauseNumber "7.3.8.1" ;
    aidgo:dqmlcStage aidgo:DecommissioningStage ;
    aidgo:inCollection iso5259:AidgoDataDecommissioningReqColl ;
    aidgo:uses iso5259:dataDecommissioning,
        iso5259:dataQualityPlan .

iso5259:AidgoReq_7_3_8_2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_8_2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "When transferring data, the organization shall ensure that the recipient meets the data quality requirements and has the authority to receive the data."@en ;
    skos:prefLabel "Data transfer — conditions"@en ;
    aidgo:clauseNumber "7.3.8.2" ;
    aidgo:dqmlcStage aidgo:DecommissioningStage ;
    aidgo:inCollection iso5259:AidgoDataTransferReqColl ;
    aidgo:uses iso5259:qualityRequirement .

iso5259:AidgoReq_7_3_8_3_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_8_3_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall ensure that data deletion does not violate applicable legal, contractual or regulatory obligations."@en ;
    skos:prefLabel "Data deletion — legal obligations"@en ;
    aidgo:clauseNumber "7.3.8.3" ;
    aidgo:dqmlcStage aidgo:DecommissioningStage ;
    aidgo:inCollection iso5259:AidgoDataDeletionReqColl .

iso5259:AidgoReq_7_3_8_3_R3 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_8_3_R3" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall document confirmation that data has been deleted from all locations."@en ;
    skos:prefLabel "Data deletion — confirmation"@en ;
    aidgo:clauseNumber "7.3.8.3" ;
    aidgo:dqmlcStage aidgo:DecommissioningStage ;
    aidgo:inCollection iso5259:AidgoDataDeletionReqColl .

iso5259:AidgoReq_7_3_8_4_R1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_8_4_R1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "When partial data deletion is requested, the organization shall identify the exact scope of data items to be deleted."@en ;
    skos:prefLabel "Partial deletion — identify scope"@en ;
    aidgo:clauseNumber "7.3.8.4" ;
    aidgo:dqmlcStage aidgo:DecommissioningStage ;
    aidgo:inCollection iso5259:AidgoPartialDeletionReqColl ;
    aidgo:uses iso5259:dataItem .

iso5259:AidgoReq_7_3_8_4_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_8_4_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall assess the impact of partial deletion on the remaining dataset quality."@en ;
    skos:prefLabel "Partial deletion — impact assessment"@en ;
    aidgo:clauseNumber "7.3.8.4" ;
    aidgo:dqmlcStage aidgo:DecommissioningStage ;
    aidgo:inCollection iso5259:AidgoPartialDeletionReqColl ;
    aidgo:uses iso5259:dataset .

iso5259:AidgoReq_7_3_8_4_R3 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_8_4_R3" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall execute the partial deletion and confirm that the requested data items have been removed."@en ;
    skos:prefLabel "Partial deletion — execute and confirm"@en ;
    aidgo:clauseNumber "7.3.8.4" ;
    aidgo:dqmlcStage aidgo:DecommissioningStage ;
    aidgo:inCollection iso5259:AidgoPartialDeletionReqColl ;
    aidgo:uses iso5259:dataItem .

iso5259:AidgoReq_8_2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall apply the horizontal processes (verification and validation, configuration management, change management, and risk management) across all stages of the DQMLC."@en ;
    skos:prefLabel "Horizontal processes General"@en ;
    aidgo:clauseNumber "8.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoHorizontalGeneralReqColl ;
    aidgo:uses iso5259:changeManagement,
        iso5259:configurationManagement,
        iso5259:dataQualityManagementLifeCycle,
        iso5259:riskManagement,
        iso5259:verificationAndValidation .

iso5259:AidgoReq_8_3_1_1_R1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_1_1_R1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall apply verification and validation processes throughout all stages of the DQMLC."@en ;
    skos:prefLabel "V&V — apply throughout"@en ;
    aidgo:clauseNumber "8.3.1.1" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoVVReqColl ;
    aidgo:uses iso5259:dataQualityManagementLifeCycle,
        iso5259:verificationAndValidation .

iso5259:AidgoReq_8_3_1_1_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_1_1_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Verification and validation activities shall be performed by personnel with appropriate independence from the activities being verified or validated."@en ;
    skos:prefLabel "V&V — independent personnel"@en ;
    aidgo:clauseNumber "8.3.1.1" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoVVReqColl ;
    aidgo:uses iso5259:verificationAndValidation .

iso5259:AidgoReq_8_3_1_2_R1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_1_2_R1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall define quality gate criteria for each DQMLC stage in the data quality plan."@en ;
    skos:prefLabel "Quality gates — define criteria"@en ;
    aidgo:clauseNumber "8.3.1.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoQualityGatesReqColl ;
    aidgo:uses iso5259:dataQualityManagementLifeCycle,
        iso5259:dataQualityPlan .

iso5259:AidgoReq_8_3_1_2_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_1_2_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "A DQMLC stage shall only be entered when all quality gate criteria for the preceding stage have been met and documented."@en ;
    skos:prefLabel "Quality gates — enforce progression"@en ;
    aidgo:clauseNumber "8.3.1.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoQualityGatesReqColl ;
    aidgo:uses iso5259:dataQualityManagementLifeCycle .

iso5259:AidgoReq_8_3_1_2_R3 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_1_2_R3" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Any deviation from quality gate criteria shall be documented with a justification and approved by appropriate authority before progression."@en ;
    skos:prefLabel "Quality gates — deviations"@en ;
    aidgo:clauseNumber "8.3.1.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoQualityGatesReqColl .

iso5259:AidgoReq_8_3_1_2_R4 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_1_2_R4" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Quality gate criteria shall be objectively measurable using defined data quality measures."@en ;
    skos:prefLabel "Quality gates — objectively measurable"@en ;
    aidgo:clauseNumber "8.3.1.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoQualityGatesReqColl ;
    aidgo:uses iso5259:dataQualityMeasure .

iso5259:AidgoReq_8_3_2_R1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_2_R1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall identify all configuration items (data, data specifications, plans, tools, and work products) subject to configuration management."@en ;
    skos:prefLabel "Configuration management — identify items"@en ;
    aidgo:clauseNumber "8.3.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoConfigMgmtReqColl ;
    aidgo:uses iso5259:configurationManagement,
        iso5259:dataSpecificationDoc .

iso5259:AidgoReq_8_3_2_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_2_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall implement version control for all configuration items to ensure traceability and reproducibility."@en ;
    skos:prefLabel "Configuration management — version control"@en ;
    aidgo:clauseNumber "8.3.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoConfigMgmtReqColl ;
    aidgo:uses iso5259:configurationManagement .

iso5259:AidgoReq_8_3_2_R3 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_2_R3" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall establish and maintain baselines for configuration items at defined DQMLC milestones."@en ;
    skos:prefLabel "Configuration management — baseline"@en ;
    aidgo:clauseNumber "8.3.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoConfigMgmtReqColl ;
    aidgo:uses iso5259:configurationManagement,
        iso5259:dataQualityManagementLifeCycle .

iso5259:AidgoReq_8_3_2_R4 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_2_R4" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall maintain records of the status of all configuration items throughout the DQMLC."@en ;
    skos:prefLabel "Configuration management — status accounting"@en ;
    aidgo:clauseNumber "8.3.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoConfigMgmtReqColl ;
    aidgo:uses iso5259:configurationManagement,
        iso5259:dataQualityManagementLifeCycle .

iso5259:AidgoReq_8_3_3_2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_3_2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall establish and maintain a change management process that ensures all changes to data, requirements or processes are assessed and approved before implementation."@en ;
    skos:prefLabel "Change management planning"@en ;
    aidgo:clauseNumber "8.3.3.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoChangeMgmtReqColl ;
    aidgo:uses iso5259:changeManagement .

iso5259:AidgoReq_8_3_3_6_R1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_3_6_R1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Approved changes shall be implemented in accordance with the approved change request and all affected configuration items shall be updated."@en ;
    skos:prefLabel "Change implementation — implement"@en ;
    aidgo:clauseNumber "8.3.3.6" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoChangeDocumentationReqColl .

iso5259:AidgoReq_8_3_3_6_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_3_6_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall verify that the implemented change achieves the intended objective without introducing unacceptable side effects."@en ;
    skos:prefLabel "Change implementation — verify"@en ;
    aidgo:clauseNumber "8.3.3.6" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoChangeDocumentationReqColl .

iso5259:AidgoReq_8_3_4_R3 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_4_R3" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall monitor identified risks throughout the DQMLC and update the risk assessment when the risk environment changes."@en ;
    skos:prefLabel "Risk management — monitor"@en ;
    aidgo:clauseNumber "8.3.4.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoRiskManagementReqColl ;
    aidgo:uses iso5259:dataQualityManagementLifeCycle,
        iso5259:riskManagement .

iso5259:AidgoReq_8_3_4_R4 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_4_R4" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall communicate significant data quality risks to relevant stakeholders."@en ;
    skos:prefLabel "Risk management — communicate"@en ;
    aidgo:clauseNumber "8.3.4.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoRiskManagementReqColl ;
    aidgo:uses iso5259:dataQuality,
        iso5259:riskManagement,
        iso5259:stakeholder .

iso5259:AidgoVVImprovementReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoVVImprovementReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoVVReqColl ;
    skos:prefLabel "V&V improvement"@en ;
    aidgo:clauseNumber "8.3.1.3" .

iso5259:analytics a aidgo:Concept ;
    dct:identifier "analytics" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:altLabel "data analytics"@en ;
    skos:definition "Composite concept consisting of data acquisition, collection, validation, processing including quantification, visualisation, documentation and interpretation."@en ;
    skos:prefLabel "analytics"@en ;
    aidgo:clauseNumber "3.11" .

iso5259:boundingBox a aidgo:Concept ;
    dct:identifier "boundingBox" ;
    dct:source "ISO/IEC 5259-2" ;
    skos:definition "Minimum n-dimensional rectangle aligned with the axes of a coordinate system that entirely contains an object."@en ;
    skos:prefLabel "bounding box"@en ;
    aidgo:clauseNumber "3.1" .

iso5259:cluster a aidgo:Concept ;
    dct:identifier "cluster" ;
    dct:source "ISO/IEC 5259-2" ;
    skos:broader iso5259:dataset ;
    skos:definition "Group of data having similar properties or characteristics as determined by a clustering algorithm."@en ;
    skos:prefLabel "cluster"@en ;
    aidgo:clauseNumber "3.9" .

iso5259:dataAccuracy a aidgo:Concept ;
    dct:identifier "dataAccuracy" ;
    dct:source "ISO/IEC 5259-5" ;
    skos:broader iso5259:dataQualityCharacteristic ;
    skos:definition "Degree to which data correctly represents the real-world values it is intended to model."@en ;
    skos:prefLabel "data accuracy"@en ;
    aidgo:clauseNumber "5-acc" .

iso5259:dataAnnotation a aidgo:Concept ;
    dct:identifier "dataAnnotation" ;
    dct:source "ISO/IEC 5259-4" ;
    skos:altLabel "annotation"@en ;
    skos:broader iso5259:dataLabelling ;
    skos:definition "Process of adding metadata or labels to raw data to make it meaningful for ML training."@en ;
    skos:prefLabel "data annotation"@en ;
    aidgo:clauseNumber "4-dan" .

iso5259:dataArchitecture a aidgo:Concept ;
    dct:identifier "dataArchitecture" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:definition "Design that describes the structure and arrangement of data and the processes for managing data at the organisation level."@en ;
    skos:prefLabel "data architecture"@en ;
    aidgo:clauseNumber "3.19" .

iso5259:dataBalance a aidgo:Concept ;
    dct:identifier "dataBalance" ;
    dct:source "ISO/IEC 5259-5" ;
    skos:broader iso5259:dataQualityCharacteristic ;
    skos:definition "Degree to which the distribution of values across categories in a dataset reflects the intended distribution for the ML task."@en ;
    skos:prefLabel "data balance"@en ;
    aidgo:clauseNumber "5-bal" .

iso5259:dataBias a aidgo:Concept ;
    dct:identifier "dataBias" ;
    dct:source "ISO/IEC 5259-5" ;
    skos:broader iso5259:dataQualityCharacteristic ;
    skos:definition "Systematic deviation in data from a true value or representation of the target population, potentially leading to unfair or inaccurate outcomes."@en ;
    skos:prefLabel "data bias"@en ;
    aidgo:clauseNumber "5-db" .

iso5259:dataCompleteness a aidgo:Concept ;
    dct:identifier "dataCompleteness" ;
    dct:source "ISO/IEC 5259-5" ;
    skos:broader iso5259:dataQualityCharacteristic ;
    skos:definition "Degree to which all required data items are present in a dataset and have defined, non-empty values."@en ;
    skos:prefLabel "data completeness"@en ;
    aidgo:clauseNumber "5-dc" .

iso5259:dataConsistency a aidgo:Concept ;
    dct:identifier "dataConsistency" ;
    dct:source "ISO/IEC 5259-5" ;
    skos:broader iso5259:dataQualityCharacteristic ;
    skos:definition "Degree to which data is free from contradictions and coherent within a dataset and across related datasets."@en ;
    skos:prefLabel "data consistency"@en ;
    aidgo:clauseNumber "5-con" .

iso5259:dataCurrentness a aidgo:Concept ;
    dct:identifier "dataCurrentness" ;
    dct:source "ISO/IEC 5259-5" ;
    skos:altLabel "timeliness"@en ;
    skos:broader iso5259:dataQualityCharacteristic ;
    skos:definition "Degree to which data represents the current state of the phenomenon it models at a given point in time."@en ;
    skos:prefLabel "data currentness"@en ;
    aidgo:clauseNumber "5-cur" .

iso5259:dataDrift a aidgo:Concept ;
    dct:identifier "dataDrift" ;
    dct:source "ISO/IEC 5259-5" ;
    skos:broader iso5259:dataQualityCharacteristic ;
    skos:definition "Change over time in the statistical properties of data used in analytics or ML that can degrade model performance."@en ;
    skos:prefLabel "data drift"@en ;
    aidgo:clauseNumber "5-dd" .

iso5259:dataFrame a aidgo:Concept ;
    dct:identifier "dataFrame" ;
    dct:source "ISO/IEC 5259-2" ;
    skos:broader iso5259:dataRecord ;
    skos:definition "Set of data records with a specific domain or purpose and the same data items, used for analytics and ML."@en ;
    skos:prefLabel "data frame"@en ;
    aidgo:clauseNumber "3.8" .

iso5259:dataGovernance a aidgo:Concept ;
    dct:identifier "dataGovernance" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:definition "Property or ability for coordinated management of data asset management strategy, including policies, procedures, standards, and guidelines."@en ;
    skos:prefLabel "data governance"@en ;
    aidgo:clauseNumber "3.15" .

iso5259:dataHolder a aidgo:Concept ;
    dct:identifier "dataHolder" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:definition "Party that has legal control to authorize data processing of the data by other parties."@en ;
    skos:prefLabel "data holder"@en ;
    aidgo:clauseNumber "3.2" .

iso5259:dataInteroperability a aidgo:Concept ;
    dct:identifier "dataInteroperability" ;
    dct:source "ISO/IEC 5259-4" ;
    skos:definition "Ability of data from one system to be understood and used by another system without special effort."@en ;
    skos:prefLabel "data interoperability"@en ;
    aidgo:clauseNumber "4-di" .

iso5259:dataPrivacy a aidgo:Concept ;
    dct:identifier "dataPrivacy" ;
    dct:source "ISO/IEC 5259-4" ;
    skos:definition "Protection of personally identifiable information (PII) in datasets during data quality processes."@en ;
    skos:prefLabel "data privacy"@en ;
    aidgo:clauseNumber "4-dpriv" .

iso5259:dataQualityAssessment a aidgo:Concept ;
    dct:identifier "dataQualityAssessment" ;
    dct:source "ISO/IEC 5259-4" ;
    skos:broader iso5259:dataQualityManagement ;
    skos:definition "Use of data quality measures to evaluate whether a dataset meets the organisation's needs."@en ;
    skos:prefLabel "data quality assessment"@en ;
    aidgo:clauseNumber "4-dqa" .

iso5259:dataQualityImprovement a aidgo:Concept ;
    dct:identifier "dataQualityImprovement" ;
    dct:source "ISO/IEC 5259-4" ;
    skos:broader iso5259:dataQualityManagement ;
    skos:definition "Application of data transformations to a dataset to improve its quality to the extent it meets the organisation's needs."@en ;
    skos:prefLabel "data quality improvement"@en ;
    aidgo:clauseNumber "4-dqi" .

iso5259:dataQualityManagementSystem a aidgo:Concept ;
    dct:identifier "dataQualityManagementSystem" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:dataQualityManagement ;
    skos:definition "Part of an organisation's management system which addresses data quality planning, control, assurance and improvement."@en ;
    skos:prefLabel "data quality management system"@en ;
    aidgo:clauseNumber "3-dqms" .

iso5259:dataQualityReport a aidgo:Concept ;
    dct:identifier "dataQualityReport" ;
    dct:source "ISO/IEC 5259-4" ;
    skos:definition "Document expressing data quality requirements, measures, results of measurements, and an assessment of whether data meets requirements."@en ;
    skos:prefLabel "data quality report"@en ;
    aidgo:clauseNumber "4-dqr" .

iso5259:dataRelevance a aidgo:Concept ;
    dct:identifier "dataRelevance" ;
    dct:source "ISO/IEC 5259-5" ;
    skos:broader iso5259:dataQualityCharacteristic ;
    skos:definition "Degree to which data is applicable and useful for the specified analytics or ML purpose."@en ;
    skos:prefLabel "data relevance"@en ;
    aidgo:clauseNumber "5-rel" .

iso5259:dataSampling a aidgo:Concept ;
    dct:identifier "dataSampling" ;
    dct:source "ISO/IEC 5259-4" ;
    skos:broader iso5259:dataPreprocessing ;
    skos:definition "Process of selecting a subset of data from a dataset according to a defined method."@en ;
    skos:prefLabel "data sampling"@en ;
    aidgo:clauseNumber "4-ds" .

iso5259:dataTransformation a aidgo:Concept ;
    dct:identifier "dataTransformation" ;
    dct:source "ISO/IEC 5259-4" ;
    skos:broader iso5259:dataPreprocessing ;
    skos:definition "Converting data from one representation or space to another with minimal loss of content."@en ;
    skos:prefLabel "data transformation"@en ;
    aidgo:clauseNumber "4-dt" .

iso5259:dataUser a aidgo:Concept ;
    dct:identifier "dataUser" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:definition "Party that is authorized to perform processing of data under the legal control of a data holder."@en ;
    skos:prefLabel "data user"@en ;
    aidgo:clauseNumber "3.3" .

iso5259:emptyDataItem a aidgo:Concept ;
    dct:identifier "emptyDataItem" ;
    dct:source "ISO/IEC 5259-2" ;
    skos:broader iso5259:dataItem ;
    skos:definition "Data item whose data value has no value, i.e. Null or None."@en ;
    skos:prefLabel "empty data item"@en ;
    aidgo:clauseNumber "3.10" .

iso5259:feature a aidgo:Concept ;
    dct:identifier "feature" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:broader iso5259:attribute ;
    skos:definition "<machine learning> Measurable property of an object or event in the context of an analytics or ML task."@en ;
    skos:prefLabel "feature"@en ;
    aidgo:clauseNumber "3.13" .

iso5259:groundTruth a aidgo:Concept ;
    dct:identifier "groundTruth" ;
    dct:source "ISO/IEC 5259-4" ;
    skos:broader iso5259:dataLabelling ;
    skos:definition "Data label or annotation that is assumed to be correct or accurate for use as training or testing data."@en ;
    skos:prefLabel "ground truth"@en ;
    aidgo:clauseNumber "4-gt" .

iso5259:measuredValue a aidgo:Concept ;
    dct:identifier "measuredValue" ;
    dct:source "ISO/IEC 5259-2" ;
    skos:broader iso5259:dataQualityMeasure ;
    skos:definition "Value attributed to a data quality measure obtained by measurement."@en ;
    skos:prefLabel "measured value"@en ;
    aidgo:clauseNumber "3.14" .

iso5259:measurementFunction a aidgo:Concept ;
    dct:identifier "measurementFunction" ;
    dct:source "ISO/IEC 5259-2" ;
    skos:broader iso5259:measurement ;
    skos:definition "Algorithm or calculation performed to combine two or more quality measure elements."@en ;
    skos:prefLabel "measurement function"@en ;
    aidgo:clauseNumber "3.15" .

iso5259:mlProject a aidgo:Concept ;
    dct:identifier "mlProject" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:altLabel "ML project"@en ;
    skos:definition "Project that utilizes analytics and machine learning and is responsible for the associated data throughout the data's entire life cycle."@en ;
    skos:prefLabel "machine learning project"@en ;
    aidgo:clauseNumber "3.18" .

iso5259:organization a aidgo:Concept ;
    dct:identifier "organization" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Person or group of people that has its own functions with responsibilities, authorities and relationships to achieve its objectives."@en ;
    skos:prefLabel "organization"@en ;
    aidgo:clauseNumber "3-ref" .

iso5259:overfitting a aidgo:Concept ;
    dct:identifier "overfitting" ;
    dct:source "ISO/IEC 5259-2" ;
    skos:definition "<machine learning> Creating a model which fits the training data too precisely and fails to generalise on new data."@en ;
    skos:prefLabel "overfitting"@en ;
    aidgo:clauseNumber "3.16" .

iso5259:productionData a aidgo:Concept ;
    dct:identifier "productionData" ;
    dct:source "ISO/IEC 5259-5" ;
    skos:broader iso5259:targetData ;
    skos:definition "Data provided to a deployed ML model in the operational environment."@en ;
    skos:prefLabel "production data"@en ;
    aidgo:clauseNumber "5-pd" .

iso5259:qualityGate a aidgo:Concept ;
    dct:identifier "qualityGate" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Objectively assessable quality target for work products at each stage of the DQMLC; a stage shall only be entered with verified and validated input."@en ;
    skos:prefLabel "data life cycle quality gate"@en ;
    aidgo:clauseNumber "3-qg" .

iso5259:rawData a aidgo:Concept ;
    dct:identifier "rawData" ;
    dct:source "ISO/IEC 5259-2" ;
    skos:broader iso5259:data ;
    skos:definition "Data in its originally acquired form from its source, before subsequent processing."@en ;
    skos:prefLabel "raw data"@en ;
    aidgo:clauseNumber "3.18" .

iso5259:trainingData a aidgo:Concept ;
    dct:identifier "trainingData" ;
    dct:source "ISO/IEC 5259-5" ;
    skos:broader iso5259:targetData ;
    skos:definition "Data used to train an ML algorithm to produce a trained ML model."@en ;
    skos:prefLabel "training data"@en ;
    aidgo:clauseNumber "5-td" .

iso5259:validationData a aidgo:Concept ;
    dct:identifier "validationData" ;
    dct:source "ISO/IEC 5259-5" ;
    skos:broader iso5259:targetData ;
    skos:definition "Data used to provide an evaluation of the trained ML model and for tuning its non-learnable parameters to prevent underfitting or overfitting."@en ;
    skos:prefLabel "validation data"@en ;
    aidgo:clauseNumber "5-vd" .

iso5259:visualisation a aidgo:Concept ;
    dct:identifier "visualisation" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:altLabel "scientific visualisation"@en ;
    skos:definition "Representation of data in a visual form that enables a human to directly understand or interact with the data."@en ;
    skos:prefLabel "visualisation"@en ;
    aidgo:clauseNumber "3.17" .

tair:decomposes a owl:ObjectProperty ;
    rdfs:label "decomposes"@en ;
    rdfs:comment "Links an atomic (conjunctive) requirement to the compound requirement it is extracted from."@en ;
    rdfs:isDefinedBy <https://w3id.org/tair> .

oslc_rm:RequirementCollection a owl:Class ;
    rdfs:label "Requirement collection (OSLC RM)"@en .

aidgo:AugmentationStage a aidgo:DQMLCStage ;
    skos:inScheme aidgo:DQMLCStageScheme ;
    skos:notation "7.3.6" ;
    skos:prefLabel "Data augmentation"@en .

aidgo:ConflictsWith a aidgo:AlignmentType ;
    skos:definition "Fulfilling the technical requirement restricts or contradicts fulfilling the legal requirement."@en ;
    skos:inScheme aidgo:AlignmentTypeScheme ;
    skos:prefLabel "Conflicts with"@en ;
    skos:scopeNote "There exists a relevant S such that Sat(S, R_iso) and A entail not Sat(S, R_legal)."@en ;
    skos:topConceptOf aidgo:AlignmentTypeScheme .

aidgo:RelatedTo a aidgo:AlignmentType ;
    rdfs:seeAlso skos:relatedMatch ;
    skos:definition "The requirements share subject matter but fulfilling the technical requirement contributes to no condition of the legal requirement."@en ;
    skos:inScheme aidgo:AlignmentTypeScheme ;
    skos:prefLabel "Related to"@en ;
    skos:topConceptOf aidgo:AlignmentTypeScheme .

aidgo:Source_EUAIAct_Art10 a prov:Entity ;
    rdfs:label "Regulation (EU) 2024/1689 (AI Act), Article 10"@en ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> .

iso5259:AidgoDataAugmentationReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataAugmentationReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoSupportReqColl ;
    skos:definition "Requirements for data augmentation processes."@en ;
    skos:prefLabel "Data augmentation General"@en ;
    aidgo:clauseNumber "7.3.6.1" .

iso5259:AidgoDataSourceReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataSourceReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataAcquisitionReqColl ;
    skos:definition "Requirements concerning data source and delegation of acquisition responsibilities."@en ;
    skos:prefLabel "Data source delegation"@en ;
    aidgo:clauseNumber "7.3.4.2" .

iso5259:AidgoDataTransferReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataTransferReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataDecommissioningReqColl ;
    skos:prefLabel "Data transfer"@en ;
    aidgo:clauseNumber "7.3.8.2" .

iso5259:AidgoHorizontalGeneralReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoHorizontalGeneralReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoOperationReqColl ;
    skos:prefLabel "Horizontal processes General"@en ;
    aidgo:clauseNumber "8.2" .

iso5259:attribute a aidgo:Concept ;
    dct:identifier "attribute" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:definition "Property or characteristic of an object that can be distinguished quantitatively or qualitatively."@en ;
    skos:prefLabel "attribute"@en ;
    aidgo:clauseNumber "3.12" .

iso5259:dataRecord a aidgo:Concept ;
    dct:identifier "dataRecord" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:broader iso5259:dataItem ;
    skos:definition "Set of related data items treated as a unit."@en ;
    skos:prefLabel "data record"@en ;
    aidgo:clauseNumber "3.21" .

iso5259:representativeness a aidgo:Concept ;
    dct:identifier "representativeness" ;
    dct:source "ISO/IEC 5259-5" ;
    skos:broader iso5259:dataQualityCharacteristic ;
    skos:definition "Degree to which the statistical properties of a dataset reflect those of the target population for the intended use."@en ;
    skos:prefLabel "representativeness"@en ;
    aidgo:clauseNumber "5-rep" .

iso5259:testData a aidgo:Concept ;
    dct:identifier "testData" ;
    dct:source "ISO/IEC 5259-5" ;
    skos:broader iso5259:targetData ;
    skos:definition "Data used to evaluate the final performance of a trained ML model independently of training."@en ;
    skos:prefLabel "test data"@en ;
    aidgo:clauseNumber "5-testd" .

aiapr:AiaPrReq_10.2_2 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.2_2" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "[Data governance and management practices shall concern in particular] the relevant design choices."@en ;
    skos:prefLabel "Governance shall concern relevant design choices"@en ;
    aidgo:alignedWith iso5259:AidgoReq_7_3_2_2 ;
    aidgo:articleReference "Art. 10(2)(a)" ;
    aidgo:coverageStatus aidgo:PartiallyCovered .

aiapr:AiaPrReq_10.2_5 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.2_5" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "[Data governance and management practices shall concern in particular] the formulation of assumptions, in particular with respect to the information that the data is supposed to measure and represent."@en ;
    skos:prefLabel "Governance shall concern formulation of assumptions"@en ;
    aidgo:alignedWith iso5259:AidgoReq_7_3_2_3_R2 ;
    aidgo:articleReference "Art. 10(2)(d)" ;
    aidgo:coverageStatus aidgo:PartiallyCovered .

aiapr:AiaPrReq_10.2_6 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.2_6" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "[Data governance and management practices shall concern in particular] an assessment of the availability, quantity and suitability of the data sets that are needed."@en ;
    skos:prefLabel "Governance shall concern assessment of dataset availability and suitability"@en ;
    aidgo:alignedWith iso5259:AidgoConjReq_7.3.1.1_Ra ;
    aidgo:articleReference "Art. 10(2)(e)" ;
    aidgo:coverageStatus aidgo:PartiallyCovered .

aiapr:AiaPrReq_10.2_8 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.2_8" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "[Data governance and management practices shall concern in particular] the identification of any data gaps or shortcomings, and how those gaps and shortcomings can be addressed."@en ;
    skos:prefLabel "Governance shall concern identification of data gaps and shortcomings"@en ;
    aidgo:alignedWith iso5259:AidgoReq_8_3_4_R2 ;
    aidgo:articleReference "Art. 10(2)(h)" ;
    aidgo:coverageStatus aidgo:PartiallyCovered .

aiapr:AiaPrReq_10.3_2 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.3_2" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "Datasets shall have the appropriate statistical properties, including as regards the persons or groups of persons on which the high-risk AI system is intended to be used."@en ;
    skos:prefLabel "Datasets shall have appropriate statistical properties for persons/groups"@en ;
    aidgo:alignedWith iso5259:AidgoReq_7_3_2_3_R1 ;
    aidgo:articleReference "Art. 10(3)" ;
    aidgo:coverageStatus aidgo:PartiallyCovered .

aiapr:AiaPrReq_10.4 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.4" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "Datasets shall take into account the characteristics particular to the geographical, contextual, behavioural or functional setting of intended use."@en ;
    skos:prefLabel "Datasets shall account for characteristics of the deployment setting"@en ;
    aidgo:alignedWith iso5259:AidgoConjReq_7.3.1.1_Rb ;
    aidgo:articleReference "Art. 10(4)" ;
    aidgo:coverageStatus aidgo:PartiallyCovered .

aiapr:AiaPrReq_10.5 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.5" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "Providers may process special categories of personal data strictly necessary for bias detection, subject to appropriate safeguards."@en ;
    skos:prefLabel "Special categories personal data may be processed for bias detection"@en ;
    aidgo:articleReference "Art. 10(5)" ;
    aidgo:coverageStatus aidgo:NotCovered .

aiapr:AiaPrReq_10.5_a a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.5_a" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "Ensuring bias detection cannot effectively be fulfilled by processing other categories of data, including synthetic or anonymised data."@en ;
    skos:prefLabel "Bias cannot be fulfilled by synthetic/anonymised data alternatives"@en ;
    aidgo:articleReference "Art. 10(5)(a)" ;
    aidgo:coverageStatus aidgo:NotCovered .

aiapr:AiaPrReq_10.5_b a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.5_b" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "Special categories data subject to technical limitations on re-use and state-of-the-art security and privacy-preserving measures."@en ;
    skos:prefLabel "Special data subject to technical limitations and state-of-art security measures"@en ;
    aidgo:articleReference "Art. 10(5)(b)" ;
    aidgo:coverageStatus aidgo:NotCovered .

aiapr:AiaPrReq_10.5_e a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.5_e" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "The data shall be deleted once the bias has been corrected or the retention period has expired."@en ;
    skos:prefLabel "Special data deleted when bias corrected or retention period ends"@en ;
    aidgo:alignedWith iso5259:AidgoReq_7_3_8_3_R1 ;
    aidgo:articleReference "Art. 10(5)(e)" ;
    aidgo:coverageStatus aidgo:PartiallyCovered .

aiapr:AiaPrReq_10.6 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.6" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "For high-risk AI not using training techniques, paragraphs 2-5 apply only to the testing data sets."@en ;
    skos:prefLabel "For non-training AI, paragraphs 2-5 apply only to testing datasets"@en ;
    aidgo:alignedWith iso5259:AidgoReq_7_3_2_3_R1 ;
    aidgo:articleReference "Art. 10(6)" ;
    aidgo:coverageStatus aidgo:PartiallyCovered .

aidgo:FullyCovered a aidgo:CoverageStatus ;
    skos:inScheme aidgo:CoverageStatusScheme ;
    skos:prefLabel "Fully covered"@en .

aidgo:Source_ISO5259_3 a prov:Entity ;
    rdfs:label "ISO/IEC FDIS 5259-3 Data quality management requirements and guidelines"@en .

aidgo:ValidationStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "Validation status"@en .

iso5259:AidgoChangeDocumentationReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoChangeDocumentationReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoChangeMgmtReqColl ;
    skos:prefLabel "Implementing and documenting change"@en ;
    aidgo:clauseNumber "8.3.3.6" .

iso5259:AidgoConjReq_7.3.1.1_Ra a aidgo:ConjunctiveRequirement,
        aidgo:TechnicalRequirement,
        tair:ConjuntiveRequirement,
        tair:Requirement ;
    dct:identifier "AidgoConjReq_7.3.1.1_Ra" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "[The organization shall complete data motivation and conceptualization. The organization shall:] document motivation and origin of the data need"@en ;
    skos:prefLabel "Data motivation — a"@en ;
    aidgo:clauseNumber "7.3.1.1" ;
    aidgo:dqmlcStage aidgo:MotivationStage ;
    aidgo:inCollection iso5259:AidgoDataMotivationReqColl ;
    tair:decomposes iso5259:AidgoReq_7_3_1_1 .

iso5259:AidgoConjReq_7.3.5.2_Rd a aidgo:ConjunctiveRequirement,
        aidgo:TechnicalRequirement,
        tair:ConjuntiveRequirement,
        tair:Requirement ;
    dct:identifier "AidgoConjReq_7.3.5.2_Rd" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "[The organization shall specify data quality measures for cleaning, including measures for:] bias and drift"@en ;
    skos:prefLabel "Data cleaning — d"@en ;
    aidgo:clauseNumber "7.3.5.2" ;
    aidgo:dqmlcStage aidgo:PreprocessingStage ;
    aidgo:inCollection iso5259:AidgoDataCleaningReqColl ;
    aidgo:uses iso5259:dataQualityMeasure ;
    tair:decomposes iso5259:AidgoReq_7_3_5_2 .


    dct:identifier "AidgoDataHandlingReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataAcquisitionReqColl ;
    skos:definition "Requirements for data handling after collection."@en ;
    skos:prefLabel "Data handling"@en ;
    aidgo:clauseNumber "7.3.4.4" .

iso5259:AidgoDataPreprocessingReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataPreprocessingReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoSupportReqColl ;
    skos:definition "Requirements for data preprocessing processes."@en ;
    skos:prefLabel "Data preprocessing General"@en ;
    aidgo:clauseNumber "7.3.5.1" .

iso5259:AidgoDocumentationReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDocumentationReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoPlanningReqColl ;
    skos:definition "Requirements for documentation to be intelligible and accessible."@en ;
    skos:prefLabel "Documentation"@en ;
    aidgo:clauseNumber "6.3.7" .

iso5259:AidgoReq_7_3_1_2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_1_2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall: a) identify all stakeholders relevant to the data and the intended use; b) document stakeholder data quality requirements and expectations."@en ;
    skos:prefLabel "Stakeholder analysis"@en ;
    aidgo:clauseNumber "7.3.1.2" ;
    aidgo:dqmlcStage aidgo:MotivationStage ;
    aidgo:inCollection iso5259:AidgoStakeholderAnalysisReqColl ;
    aidgo:uses iso5259:qualityRequirement,
        iso5259:stakeholder .

iso5259:AidgoReq_7_3_2_1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_2_1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall specify data requirements in a data specification and validate that these requirements are consistent and complete for the intended use."@en ;
    skos:prefLabel "Data specification General"@en ;
    aidgo:clauseNumber "7.3.2.1" ;
    aidgo:dqmlcStage aidgo:SpecificationStage ;
    aidgo:inCollection iso5259:AidgoDataSpecificationReqColl ;
    aidgo:uses iso5259:dataSpecificationDoc .

iso5259:AidgoReq_7_3_4_2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_4_2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Documented conditions of the reuse or license of a dataset shall be taken into account. The organization can delegate data acquisition to a third party but remains responsible for meeting data quality requirements."@en ;
    skos:prefLabel "Data source — delegation responsibility"@en ;
    aidgo:clauseNumber "7.3.4.2" ;
    aidgo:dqmlcStage aidgo:AcquisitionStage ;
    aidgo:inCollection iso5259:AidgoDataSourceReqColl ;
    aidgo:uses iso5259:dataAcquisition,
        iso5259:dataset,
        iso5259:qualityRequirement .

iso5259:AidgoReq_7_3_6_1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_6_1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall specify data augmentation processes to meet the data specification and include them in the data quality plan."@en ;
    skos:prefLabel "Data augmentation — specify processes"@en ;
    aidgo:clauseNumber "7.3.6.1" ;
    aidgo:dqmlcStage aidgo:AugmentationStage ;
    aidgo:inCollection iso5259:AidgoDataAugmentationReqColl ;
    aidgo:uses iso5259:dataAugmentation,
        iso5259:dataQualityPlan,
        iso5259:dataSpecificationDoc .

iso5259:AidgoReq_7_3_8_3_R1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_8_3_R1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "When deleting data, the organization shall ensure that data is deleted from all storage locations, including backups and replicas."@en ;
    skos:prefLabel "Data deletion — from all storage"@en ;
    aidgo:clauseNumber "7.3.8.3" ;
    aidgo:dqmlcStage aidgo:DecommissioningStage ;
    aidgo:inCollection iso5259:AidgoDataDeletionReqColl .

iso5259:AidgoReq_8_3_4_R1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_4_R1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall conduct a risk assessment and maintain documentation with respect to risks associated to data quality."@en ;
    skos:prefLabel "Risk management — conduct assessment"@en ;
    aidgo:clauseNumber "8.3.4.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoRiskManagementReqColl ;
    aidgo:uses iso5259:dataQuality,
        iso5259:riskManagement .

iso5259:AidgoReq_8_3_4_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_4_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall manage and maintain appropriate processes to minimise identified risks. Risks shall be specified, justified and documented."@en ;
    skos:prefLabel "Risk management — minimise risks"@en ;
    aidgo:clauseNumber "8.3.4.2" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoRiskManagementReqColl ;
    aidgo:uses iso5259:riskManagement .

iso5259:AidgoStatisticalPropertiesReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoStatisticalPropertiesReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataSpecificationReqColl ;
    skos:definition "Requirements for specifying statistical properties and subset divisions."@en ;
    skos:prefLabel "Statistical properties and divisibility"@en ;
    aidgo:clauseNumber "7.3.2.3" .

iso5259:dataLabelling a aidgo:Concept ;
    dct:identifier "dataLabelling" ;
    dct:source "ISO/IEC 5259-4" ;
    skos:altLabel "data annotation"@en ;
    skos:broader iso5259:dataPreprocessing ;
    skos:definition "Process of assigning values for target variables to training, validation and testing data for supervised ML."@en ;
    skos:prefLabel "data labelling"@en ;
    aidgo:clauseNumber "4-dl" .

iso5259:dataQualityModel a aidgo:Concept ;
    dct:identifier "dataQualityModel" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:broader iso5259:dataQuality ;
    skos:definition "Defined set of characteristics with their sub-characteristics that provide a framework for specifying data quality requirements and evaluating data quality."@en ;
    skos:prefLabel "data quality model"@en ;
    aidgo:clauseNumber "3.6" .

iso5259:dataType a aidgo:Concept ;
    dct:identifier "dataType" ;
    dct:source "ISO/IEC 5259-2" ;
    skos:broader iso5259:dataItem ;
    skos:definition "Categorisation of an abstract set of possible values, characteristics, and set of operations for an attribute."@en ;
    skos:prefLabel "data type"@en ;
    aidgo:clauseNumber "3.5" .

iso5259:dataValue a aidgo:Concept ;
    dct:identifier "dataValue" ;
    dct:source "ISO/IEC 5259-2" ;
    skos:broader iso5259:dataItem ;
    skos:definition "Content of a data item."@en ;
    skos:prefLabel "data value"@en ;
    aidgo:clauseNumber "3.6" .

iso5259:measurementScale a aidgo:Concept ;
    dct:identifier "measurementScale" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:altLabel "quantity-value scale"@en ;
    skos:broader iso5259:measurement ;
    skos:definition "Ordered set of quantity values used in ranking quantities of a given kind according to magnitude."@en ;
    skos:prefLabel "measurement scale"@en ;
    aidgo:clauseNumber "3.10" .

iso5259:metadata a aidgo:Concept ;
    dct:identifier "metadata" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:definition "Data that define and describe other data."@en ;
    skos:prefLabel "metadata"@en ;
    aidgo:clauseNumber "3.22" .

aiapr:AiaPrReq_10.1 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.1" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "High-risk AI systems shall be developed on the basis of training, validation and testing data sets that meet the quality criteria referred to in paragraphs 2 to 5."@en ;
    skos:prefLabel "High-risk AI systems shall use datasets meeting quality criteria"@en ;
    aidgo:alignedWith iso5259:AidgoReq_7_3_2_1,
        iso5259:AidgoReq_7_3_3_1 ;
    aidgo:articleReference "Art. 10(1)" ;
    aidgo:coverageStatus aidgo:PartiallyCovered .

aiapr:AiaPrReq_10.2_1 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.2_1" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "Training, validation and testing data sets shall be subject to data governance and management practices appropriate for the intended purpose."@en ;
    skos:prefLabel "Datasets shall be subject to appropriate data governance practices"@en ;
    aidgo:alignedWith iso5259:AidgoConjReq_7.3.1.1_Rb,
        iso5259:AidgoReq_6_3_2 ;
    aidgo:articleReference "Art. 10(2)" ;
    aidgo:coverageStatus aidgo:FullyCovered .

aiapr:AiaPrReq_10.2_3 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.2_3" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "[Data governance and management practices shall concern in particular] data collection processes and the origin of data, and in the case of personal data, the original purpose of the data collection."@en ;
    skos:prefLabel "Governance shall concern data collection processes and origin"@en ;
    aidgo:alignedWith iso5259:AidgoReq_7_3_4_2,
        iso5259:AidgoReq_7_3_4_3 ;
    aidgo:articleReference "Art. 10(2)(b)" ;
    aidgo:coverageStatus aidgo:PartiallyCovered .

aiapr:AiaPrReq_10.2_4 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.2_4" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "[Data governance and management practices shall concern in particular] relevant data-preparation processing operations, such as annotation, labelling, cleaning, updating, enrichment and aggregation."@en ;
    skos:prefLabel "Governance shall concern data-preparation operations"@en ;
    aidgo:alignedWith iso5259:AidgoReq_7_3_5_2,
        iso5259:AidgoReq_7_3_6_1 ;
    aidgo:articleReference "Art. 10(2)(c)" ;
    aidgo:coverageStatus aidgo:PartiallyCovered .

aiapr:AiaPrReq_10.2_7 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.2_7" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "[Data governance and management practices shall concern in particular] an examination of possible biases that could affect health and safety or lead to discrimination prohibited under Union law."@en ;
    skos:prefLabel "Governance shall concern examination for biases affecting health, safety, rights"@en ;
    aidgo:alignedWith iso5259:AidgoConjReq_7.3.5.2_Rd,
        iso5259:AidgoReq_8_3_4_R1 ;
    aidgo:articleReference "Art. 10(2)(f)" ;
    aidgo:coverageStatus aidgo:PartiallyCovered .

aidgo:FunctionalEquivalence a aidgo:AlignmentBasis ;
    skos:definition "Different wording, but performing the technical requirement produces the outcome the legal requirement demands."@en ;
    skos:inScheme aidgo:AlignmentBasisScheme ;
    skos:prefLabel "Functional equivalence"@en .

aidgo:GapIdentified a aidgo:AlignmentBasis ;
    skos:definition "Examination of the standard found no requirement in scope."@en ;
    skos:inScheme aidgo:AlignmentBasisScheme ;
    skos:prefLabel "Gap identified"@en .

aidgo:LifeCycleGeneralStage a aidgo:DQMLCStage ;
    skos:inScheme aidgo:DQMLCStageScheme ;
    skos:notation "7.2" ;
    skos:prefLabel "Life cycle (general)"@en .

aidgo:NotCovered a aidgo:CoverageStatus ;
    skos:inScheme aidgo:CoverageStatusScheme ;
    skos:prefLabel "Not covered"@en .

aidgo:ValidationStatus a owl:Class ;
    rdfs:label "Validation status"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Distinguishes expert-validated assertions from machine-generated candidates."@en .

iso5259:AidgoDQLCReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDQLCReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoSupportReqColl ;
    skos:definition "General requirements for the DQMLC."@en ;
    skos:prefLabel "Data quality management life cycle General"@en ;
    aidgo:clauseNumber "7.2.1" .

iso5259:AidgoDataDeletionReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataDeletionReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataDecommissioningReqColl ;
    skos:prefLabel "Data deletion"@en ;
    aidgo:clauseNumber "7.3.8.3" .

iso5259:AidgoDataSpecificationReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataSpecificationReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoSupportReqColl ;
    skos:definition "Requirements for specifying data requirements consistently and completely."@en ;
    skos:prefLabel "Data specification General"@en ;
    aidgo:clauseNumber "7.3.2.1" .

iso5259:AidgoPartialDeletionReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoPartialDeletionReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataDecommissioningReqColl ;
    skos:prefLabel "Partial data deletion on request"@en ;
    aidgo:clauseNumber "7.3.8.4" .

iso5259:AidgoReq_11_2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_11_2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall manage data quality dependencies by: a) identifying all data quality dependencies between datasets and processes; b) documenting the impact of dependency failures on data quality; c) specifying mitigation strategies for dependency-related quality risks."@en ;
    skos:prefLabel "Data quality dependencies — management"@en ;
    aidgo:clauseNumber "11.2" ;
    aidgo:dqmlcStage aidgo:DependencyManagementStage ;
    aidgo:inCollection iso5259:AidgoDQDependenciesReqColl ;
    aidgo:uses iso5259:dataQuality,
        iso5259:dataset .

iso5259:AidgoReq_6_3_10 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_6_3_10" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall manage project-specific data by: a) establishing a suitable project-specific DQM process; b) maintaining a list of relevant DQ claims with benchmarks for each milestone; c) adopting processes to identify and manage all relevant DQ measures."@en ;
    skos:prefLabel "Project-specific DQM"@en ;
    aidgo:clauseNumber "6.3.10" ;
    aidgo:dqmlcStage aidgo:OrganisationalStage ;
    aidgo:inCollection iso5259:AidgoProjectSpecificDQReqColl .

iso5259:AidgoReq_6_3_3 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_6_3_3" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall meet data quality requirements by: a) having processes for communicating, analysing, evaluating, resolving and closing (implementing a resolution or giving a reason for not being an unreasonable risk) issues of data quality; b) documenting closed issues; c) escalating issues that cannot be closed."@en ;
    skos:prefLabel "Management of data quality issues"@en ;
    aidgo:clauseNumber "6.3.3" ;
    aidgo:dqmlcStage aidgo:OrganisationalStage ;
    aidgo:inCollection iso5259:AidgoDataQualityIssuesMgmtReqColl ;
    aidgo:uses iso5259:dataQuality,
        iso5259:qualityRequirement .

iso5259:AidgoReq_6_3_5 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_6_3_5" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall provide the resources required for data quality management, including: a) appropriate software licenses and technical support for required tools; b) required IT infrastructure or services to meet the storage and compute requirements; c) availability of skilled persons."@en ;
    skos:prefLabel "Resource management"@en ;
    aidgo:clauseNumber "6.3.5" ;
    aidgo:dqmlcStage aidgo:OrganisationalStage ;
    aidgo:inCollection iso5259:AidgoResourceMgmtReqColl ;
    aidgo:uses iso5259:dataQualityManagement .

iso5259:AidgoReq_7_3_1_1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_1_1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall: a) document motivation and origin of the data need; b) specify scope, purpose and intended use of data; c) document the data quality requirements."@en ;
    skos:prefLabel "Data motivation and conceptualization"@en ;
    aidgo:clauseNumber "7.3.1.1" ;
    aidgo:dqmlcStage aidgo:MotivationStage ;
    aidgo:inCollection iso5259:AidgoDataMotivationReqColl ;
    aidgo:uses iso5259:qualityRequirement .

iso5259:AidgoReq_8_3_3_5 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_3_5" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Change requests shall be evaluated and: a) approved, with conditions if necessary; b) deferred to a later stage; c) rejected with justification."@en ;
    skos:prefLabel "Change request evaluation and approval"@en ;
    aidgo:clauseNumber "8.3.3.5" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoChangeRequestEvalReqColl .

iso5259:AidgoStakeholderAnalysisReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoStakeholderAnalysisReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataMotivationReqColl ;
    skos:definition "Requirements for identifying and engaging stakeholders."@en ;
    skos:prefLabel "Stakeholder analysis"@en ;
    aidgo:clauseNumber "7.3.1.2" .

iso5259:AidgoTrackingImprovementReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoTrackingImprovementReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataProvisioningReqColl ;
    skos:definition "Requirements for tracking provisioned data and improving the provisioning process."@en ;
    skos:prefLabel "Tracking and improvement"@en ;
    aidgo:clauseNumber "7.3.7.4" .

iso5259:data a aidgo:Concept ;
    dct:identifier "data" ;
    dct:source "ISO/IEC 5259-2" ;
    skos:definition "Re-interpretable representation of information in a formalized manner suitable for communication, interpretation, or processing."@en ;
    skos:prefLabel "data"@en ;
    aidgo:clauseNumber "3.2" .

iso5259:dataAugmentation a aidgo:Concept ;
    dct:identifier "dataAugmentation" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:dataLifeCycle ;
    skos:definition "Processes that increase the diversity or quantity of data in a dataset in a controlled manner to meet the data specification."@en ;
    skos:prefLabel "data augmentation"@en ;
    aidgo:clauseNumber "3-daug" .

iso5259:verificationAndValidation a aidgo:Concept ;
    dct:identifier "verificationAndValidation" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:altLabel "V&V"@en ;
    skos:definition "Processes that monitor and assess data quality throughout all stages of the DQMLC using measurable quality criteria."@en ;
    skos:prefLabel "verification and validation"@en ;
    aidgo:clauseNumber "3-vv" .

aiapr:AiaPrReq_10.3_1 a aidgo:LegalRequirement,
        tair:Requirement ;
    dct:identifier "AiaPrReq_10.3_1" ;
    dct:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj> ;
    skos:definition "Training, validation and testing data sets shall be sufficiently representative for the intended purpose."@en ;
    skos:prefLabel "Datasets shall be sufficiently representative"@en ;
    aidgo:alignedWith iso5259:AidgoConjReq_7.3.1.1_Rb,
        iso5259:AidgoReq_7_3_2_3_R2,
        iso5259:AidgoReq_7_3_5_2 ;
    aidgo:articleReference "Art. 10(3)" ;
    aidgo:coverageStatus aidgo:FullyCovered .

aidgo:ConceptualCoverage a aidgo:AlignmentBasis ;
    skos:definition "The technical requirement addresses the concept underlying the legal requirement at a more general or more specific level."@en ;
    skos:inScheme aidgo:AlignmentBasisScheme ;
    skos:prefLabel "Conceptual coverage"@en .

aidgo:CoverageStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "Obligation coverage status"@en ;
    skos:scopeNote "FullyCovered iff every assertion on the obligation is CompletelySatisfies; NotCovered iff every assertion is NoAlignment; PartiallyCovered otherwise."@en .

aidgo:DependencyManagementStage a aidgo:DQMLCStage ;
    skos:inScheme aidgo:DQMLCStageScheme ;
    skos:notation "11" ;
    skos:prefLabel "Management of data quality dependencies"@en .

iso5259:AidgoChangeRequestEvalReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoChangeRequestEvalReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoChangeMgmtReqColl ;
    skos:prefLabel "Change request evaluation"@en ;
    aidgo:clauseNumber "8.3.3.5" .

iso5259:AidgoConfigMgmtReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoConfigMgmtReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoOperationReqColl ;
    skos:prefLabel "Configuration management"@en ;
    aidgo:clauseNumber "8.3.2" .

iso5259:AidgoDQDependenciesReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDQDependenciesReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:prefLabel "Data quality dependencies"@en ;
    aidgo:clauseNumber "11" .

iso5259:AidgoDataQualityIssuesMgmtReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataQualityIssuesMgmtReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoPlanningReqColl ;
    skos:definition "Requirements for processes to communicate, analyse, evaluate, resolve and close data quality issues."@en ;
    skos:prefLabel "Management of data quality issues"@en ;
    aidgo:clauseNumber "6.3.3" .

iso5259:AidgoProjectSpecificDQReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoProjectSpecificDQReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoPlanningReqColl ;
    skos:definition "Requirements for project-specific data quality management."@en ;
    skos:prefLabel "Project-specific DQM"@en ;
    aidgo:clauseNumber "6.3.10" .

iso5259:AidgoQualityGatesReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoQualityGatesReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoVVReqColl ;
    skos:prefLabel "Data life cycle quality gates"@en ;
    aidgo:clauseNumber "8.3.1.2" .

iso5259:AidgoReq_6_3_4 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_6_3_4" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall: a) document required skills and tools to process the data; b) ensure that involved persons have sufficient skills to perform their activities and duties; c) maintain proof of sufficient skill with the data quality system; d) keep appropriate records of training and experience that substantiate claims of competency."@en ;
    skos:prefLabel "Competence management"@en ;
    aidgo:clauseNumber "6.3.4" ;
    aidgo:dqmlcStage aidgo:OrganisationalStage ;
    aidgo:inCollection iso5259:AidgoCompetenceMgmtReqColl ;
    aidgo:uses iso5259:dataQuality .

iso5259:AidgoReq_6_3_9 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_6_3_9" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Data quality shall be confirmed by appropriate data quality measures in accordance with ISO/IEC 5259-2. All work products shall undergo confirmation reviews that: a) confirm that work products meet the data specification; b) confirm that data quality measures have been applied correctly; c) identify any remaining open issues; d) authorise progression to the next life cycle stage."@en ;
    skos:prefLabel "Confirmation review and DQ measures"@en ;
    aidgo:clauseNumber "6.3.9" ;
    aidgo:dqmlcStage aidgo:OrganisationalStage ;
    aidgo:inCollection iso5259:AidgoConfirmationReviewReqColl ;
    aidgo:uses iso5259:dataQuality,
        iso5259:dataQualityMeasure,
        iso5259:dataSpecificationDoc .

iso5259:AidgoReq_7_3_2_3_R1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_2_3_R1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The data specification shall include specification of valid divisions into subsets (e.g. training, validation and test data) and the criteria for assigning data items to subsets."@en ;
    skos:prefLabel "Statistical properties — subset divisions"@en ;
    aidgo:clauseNumber "7.3.2.3" ;
    aidgo:dqmlcStage aidgo:SpecificationStage ;
    aidgo:inCollection iso5259:AidgoStatisticalPropertiesReqColl ;
    aidgo:uses iso5259:dataItem,
        iso5259:dataSpecificationDoc,
        iso5259:testData .

iso5259:AidgoReq_7_3_2_3_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_2_3_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall determine and maintain for each subset: relevant statistical properties, representativeness with respect to the target population, and appropriate size to meet the intended purpose."@en ;
    skos:prefLabel "Statistical properties — representativeness"@en ;
    aidgo:clauseNumber "7.3.2.3" ;
    aidgo:dqmlcStage aidgo:SpecificationStage ;
    aidgo:inCollection iso5259:AidgoStatisticalPropertiesReqColl ;
    aidgo:uses iso5259:representativeness .

iso5259:AidgoReq_7_3_7_5 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_7_5" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall specify data optimization processes that: a) reduce storage and computational overhead without reducing quality below specified thresholds; b) apply only transformations that are documented and reversible or justified; c) validate that optimised data still meets the data specification; d) maintain a record of all optimisation operations applied."@en ;
    skos:prefLabel "Data optimization"@en ;
    aidgo:clauseNumber "7.3.7.5" ;
    aidgo:dqmlcStage aidgo:ProvisioningStage ;
    aidgo:inCollection iso5259:AidgoDataOptimizationReqColl ;
    aidgo:uses iso5259:dataSpecificationDoc .

iso5259:AidgoReq_7_3_7_6_R2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_7_6_R2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall document all support commitments in a support agreement that covers: a) scope of support; b) response times and service levels; c) versioning and update policy; d) conditions for withdrawal of data."@en ;
    skos:prefLabel "Support commitment — documentation"@en ;
    aidgo:clauseNumber "7.3.7.6" ;
    aidgo:dqmlcStage aidgo:ProvisioningStage ;
    aidgo:inCollection iso5259:AidgoSupportCommitmentReqColl .

iso5259:AidgoReq_8_3_3_3 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_3_3" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Each change request shall specify: a) the data item or process affected; b) the reason for the change; c) the proposed change; d) the requestor and date."@en ;
    skos:prefLabel "Change request specification"@en ;
    aidgo:clauseNumber "8.3.3.3" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoChangeRequestSpecReqColl ;
    aidgo:uses iso5259:dataItem .

iso5259:AidgoResourceMgmtReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoResourceMgmtReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoPlanningReqColl ;
    skos:definition "Requirements for providing sufficient resources for DQM activities."@en ;
    skos:prefLabel "Resource management"@en ;
    aidgo:clauseNumber "6.3.5" .

iso5259:AidgoRiskManagementReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoRiskManagementReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoOperationReqColl ;
    skos:prefLabel "Risk management"@en ;
    aidgo:clauseNumber "8.3.4" .

iso5259:AidgoVVReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoVVReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoOperationReqColl ;
    skos:prefLabel "Verification and validation General"@en ;
    aidgo:clauseNumber "8.3.1.1" .

iso5259:changeManagement a aidgo:Concept ;
    dct:identifier "changeManagement" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Planned and initiated process before any change to data, requirements or processes to ensure all impacts are assessed and approved."@en ;
    skos:prefLabel "change management"@en ;
    aidgo:clauseNumber "3-chm" .

iso5259:dataDecommissioning a aidgo:Concept ;
    dct:identifier "dataDecommissioning" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:dataLifeCycle ;
    skos:definition "Process of retiring data either through transfer to a qualified recipient or deletion."@en ;
    skos:prefLabel "data decommissioning"@en ;
    aidgo:clauseNumber "3-ddecom" .

iso5259:dataProvenance a aidgo:Concept ;
    dct:identifier "dataProvenance" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:altLabel "provenance"@en ;
    skos:definition "Information on the place and time of origin, derivation or generation of a dataset."@en ;
    skos:prefLabel "data provenance"@en ;
    aidgo:clauseNumber "3.16" .

iso5259:targetData a aidgo:Concept ;
    dct:identifier "targetData" ;
    dct:source "ISO/IEC 5259-2" ;
    skos:broader iso5259:data ;
    skos:definition "Data used in an analytics or ML task whose quality is measured."@en ;
    skos:prefLabel "target data"@en ;
    aidgo:clauseNumber "3.19" .

aidgo:AlignmentBasisScheme a skos:ConceptScheme ;
    skos:prefLabel "AIDGO alignment bases"@en .

aidgo:CoverageStatus a owl:Class ;
    rdfs:label "Obligation coverage status"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Obligation-level summary derived from all alignment assertions on a legal requirement."@en .

iso5259:AidgoChangeMgmtReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoChangeMgmtReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoOperationReqColl ;
    skos:prefLabel "Change management"@en ;
    aidgo:clauseNumber "8.3.3" .

iso5259:AidgoChangeRequestSpecReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoChangeRequestSpecReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoChangeMgmtReqColl ;
    skos:prefLabel "Change request specification"@en ;
    aidgo:clauseNumber "8.3.3.3" .

iso5259:AidgoCompetenceMgmtReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoCompetenceMgmtReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoPlanningReqColl ;
    skos:definition "Requirements for managing skills and competence of persons involved in DQM activities."@en ;
    skos:prefLabel "Competence management"@en ;
    aidgo:clauseNumber "6.3.4" .

iso5259:AidgoDataDecommissioningReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataDecommissioningReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoSupportReqColl ;
    skos:definition "Requirements for decommissioning data."@en ;
    skos:prefLabel "Data decommissioning General"@en ;
    aidgo:clauseNumber "7.3.8.1" .

iso5259:AidgoDataMotivationReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataMotivationReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoSupportReqColl ;
    skos:definition "Requirements for documenting motivation, origin and intended use of data."@en ;
    skos:prefLabel "Data motivation and conceptualization"@en ;
    aidgo:clauseNumber "7.3.1.1" .

iso5259:AidgoDataOptimizationReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataOptimizationReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataProvisioningReqColl ;
    skos:definition "Requirements for optimising provisioned data."@en ;
    skos:prefLabel "Data optimization"@en ;
    aidgo:clauseNumber "7.3.7.5" .

iso5259:AidgoOperationReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoOperationReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:prefLabel "Operation (horizontal processes)"@en ;
    aidgo:clauseNumber "8" .

iso5259:AidgoReq_6_3_8 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_6_3_8" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The implemented processes shall be audited when appropriate. The audit shall: a) evaluate the data quality plan against the organizational rules and processes for data quality; b) determine whether planned activities have been implemented and maintained effectively; c) identify non-compliances and propose corrective actions; d) document audit findings and conclusions; e) communicate findings to relevant stakeholders."@en ;
    skos:prefLabel "Data quality audit and assessment"@en ;
    aidgo:clauseNumber "6.3.8" ;
    aidgo:dqmlcStage aidgo:OrganisationalStage ;
    aidgo:inCollection iso5259:AidgoDataQualityAuditReqColl ;
    aidgo:uses iso5259:dataQuality,
        iso5259:dataQualityPlan,
        iso5259:stakeholder .

iso5259:AidgoReq_7_3_3_2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_3_2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall establish life cycle stage-specific plans addressing: a) data acquisition plan; b) data preprocessing plan; c) data augmentation plan; d) data provisioning plan; e) data decommissioning plan."@en ;
    skos:prefLabel "Data life cycle specific plans"@en ;
    aidgo:clauseNumber "7.3.3.2" ;
    aidgo:dqmlcStage aidgo:PlanningStage ;
    aidgo:inCollection iso5259:AidgoDataLifeCyclePlansReqColl ;
    aidgo:uses iso5259:dataAcquisition,
        iso5259:dataAugmentation,
        iso5259:dataDecommissioning,
        iso5259:dataLifeCycle,
        iso5259:dataPreprocessing,
        iso5259:dataProvisioning .

iso5259:configurationManagement a aidgo:Concept ;
    dct:identifier "configurationManagement" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Planned and maintained activity defining requirements for uniquely identified and reproducible items produced or used during the data life cycle."@en ;
    skos:prefLabel "configuration management"@en ;
    aidgo:clauseNumber "3-cm" .

aidgo:AlignmentBasis a owl:Class ;
    rdfs:label "Alignment basis"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "The kind of evidence on which an alignment type is assigned."@en .

aidgo:NoAlignment a aidgo:AlignmentType ;
    skos:definition "No requirement of the standard in scope contributes to the legal requirement: a compliance gap. aidgo:technicalRequirement is rdf:nil."@en ;
    skos:inScheme aidgo:AlignmentTypeScheme ;
    skos:prefLabel "No alignment"@en ;
    skos:topConceptOf aidgo:AlignmentTypeScheme .

aidgo:SemanticEquivalence a aidgo:AlignmentBasis ;
    skos:definition "Both requirements impose the same condition, expressed in equivalent terms."@en ;
    skos:inScheme aidgo:AlignmentBasisScheme ;
    skos:prefLabel "Semantic equivalence"@en .

iso5259:AidgoConfirmationReviewReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoConfirmationReviewReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoPlanningReqColl ;
    skos:definition "Requirements for confirming data quality via measures and confirmation reviews."@en ;
    skos:prefLabel "Confirmation review and DQ measures"@en ;
    aidgo:clauseNumber "6.3.9" .

iso5259:AidgoConjReq_7.3.1.1_Rb a aidgo:ConjunctiveRequirement,
        aidgo:TechnicalRequirement,
        tair:ConjuntiveRequirement,
        tair:Requirement ;
    dct:identifier "AidgoConjReq_7.3.1.1_Rb" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "[The organization shall complete data motivation and conceptualization. The organization shall:] specify scope, purpose and intended use of data"@en ;
    skos:prefLabel "Data motivation — b"@en ;
    aidgo:clauseNumber "7.3.1.1" ;
    aidgo:dqmlcStage aidgo:MotivationStage ;
    aidgo:inCollection iso5259:AidgoDataMotivationReqColl ;
    tair:decomposes iso5259:AidgoReq_7_3_1_1 .

iso5259:AidgoDataAcquisitionReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataAcquisitionReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoSupportReqColl ;
    skos:definition "Requirements for data acquisition processes."@en ;
    skos:prefLabel "Data acquisition General"@en ;
    aidgo:clauseNumber "7.3.4.1" .

iso5259:AidgoDataLifeCyclePlansReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataLifeCyclePlansReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataPlanningReqColl ;
    skos:definition "Requirements for stage-specific planning."@en ;
    skos:prefLabel "Data life cycle specific plans"@en ;
    aidgo:clauseNumber "7.3.3.2" .

iso5259:AidgoDataQualityAuditReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataQualityAuditReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoPlanningReqColl ;
    skos:definition "Requirements for auditing implemented DQM processes."@en ;
    skos:prefLabel "Data quality audit and assessment"@en ;
    aidgo:clauseNumber "6.3.8" .

iso5259:AidgoReq_8_3_3_4 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_8_3_3_4" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Change requests shall be analysed to determine: a) impact on data quality; b) impact on dependent datasets, processes and plans; c) risks introduced by the change; d) alternative solutions; e) resources required; f) impact on schedule."@en ;
    skos:prefLabel "Change request analysis"@en ;
    aidgo:clauseNumber "8.3.3.4" ;
    aidgo:dqmlcStage aidgo:HorizontalProcessStage ;
    aidgo:inCollection iso5259:AidgoChangeRequestAnalysisReqColl ;
    aidgo:uses iso5259:dataQuality,
        iso5259:dataset .

iso5259:AidgoSupportCommitmentReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoSupportCommitmentReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataProvisioningReqColl ;
    skos:definition "Requirements for ongoing support commitment for provisioned data."@en ;
    skos:prefLabel "Support commitment"@en ;
    aidgo:clauseNumber "7.3.7.6" .

iso5259:dataAcquisition a aidgo:Concept ;
    dct:identifier "dataAcquisition" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:dataLifeCycle ;
    skos:definition "Process by which data are obtained, including collection, purchase, licensing, reuse or generation."@en ;
    skos:prefLabel "data acquisition"@en ;
    aidgo:clauseNumber "3-da" .

iso5259:dataPreprocessing a aidgo:Concept ;
    dct:identifier "dataPreprocessing" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:dataLifeCycle ;
    skos:definition "Processes applied to acquired data to improve its quality towards meeting the data specification."@en ;
    skos:prefLabel "data preprocessing"@en ;
    aidgo:clauseNumber "3-dp" .

iso5259:measurement a aidgo:Concept ;
    dct:identifier "measurement" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:definition "Set of operations having the object of determining a value of a measure."@en ;
    skos:prefLabel "measurement"@en ;
    aidgo:clauseNumber "3.9" .

aidgo:CompletelySatisfies a aidgo:AlignmentType ;
    rdfs:seeAlso skos:exactMatch ;
    skos:definition "Fulfilling the technical requirement is sufficient to fulfil the legal requirement (or its stated legal focus)."@en ;
    skos:inScheme aidgo:AlignmentTypeScheme ;
    skos:prefLabel "Completely satisfies"@en ;
    skos:scopeNote "For all S: Sat(S, R_iso) and A entail Sat(S, R_legal)."@en ;
    skos:topConceptOf aidgo:AlignmentTypeScheme .

aidgo:MotivationStage a aidgo:DQMLCStage ;
    skos:inScheme aidgo:DQMLCStageScheme ;
    skos:notation "7.3.1" ;
    skos:prefLabel "Data motivation and conceptualization"@en .

iso5259:AidgoChangeRequestAnalysisReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoChangeRequestAnalysisReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoChangeMgmtReqColl ;
    skos:prefLabel "Change request analysis"@en ;
    aidgo:clauseNumber "8.3.3.4" .

iso5259:AidgoDataPlanningReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataPlanningReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoSupportReqColl ;
    skos:definition "Requirements for establishing a data quality plan."@en ;
    skos:prefLabel "Data planning General"@en ;
    aidgo:clauseNumber "7.3.3.1" .

iso5259:AidgoReq_10_2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_10_2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall manage data processing tools to ensure they support data quality requirements, covering: a) approved tool list with version information; b) tool qualification and validation; c) access control and licensing; d) backup and recovery; e) monitoring of tool-induced data quality issues; f) tool change management; g) documentation of tool-specific data quality constraints."@en ;
    skos:prefLabel "Data processing tools — management"@en ;
    aidgo:clauseNumber "10.2" ;
    aidgo:dqmlcStage aidgo:ToolManagementStage ;
    aidgo:inCollection iso5259:AidgoDataProcessingToolsReqColl ;
    aidgo:uses iso5259:changeManagement,
        iso5259:dataQuality,
        iso5259:qualityRequirement .

iso5259:AidgoReq_7_3_3_1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_3_1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall establish a data quality plan that covers: a) the processes, activities and resources required to meet the data specification throughout the data life cycle; b) entry and exit criteria for each DQMLC stage; c) the data quality measures to be applied; d) responsibilities and authorities for DQM activities; e) schedule and milestones for DQM activities."@en ;
    skos:prefLabel "Data planning General"@en ;
    aidgo:clauseNumber "7.3.3.1" ;
    aidgo:dqmlcStage aidgo:PlanningStage ;
    aidgo:inCollection iso5259:AidgoDataPlanningReqColl ;
    aidgo:uses iso5259:dataLifeCycle,
        iso5259:dataQualityManagementLifeCycle,
        iso5259:dataQualityMeasure,
        iso5259:dataQualityPlan,
        iso5259:dataSpecificationDoc .

iso5259:AidgoReq_7_3_7_1 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_7_1" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall: a) specify data provisioning processes to meet the data specification; b) provide auditable evidence that provisioned data meets all specified data quality requirements; c) ensure that the provisioning process does not alter the data beyond what is specified; d) document all provisioning activities; e) maintain a record of all data provisioned, including version and provenance information; f) ensure that recipients are authorised to receive the provisioned data; g) ensure that provisioning complies with applicable legal and contractual obligations."@en ;
    skos:prefLabel "Data provisioning General"@en ;
    aidgo:clauseNumber "7.3.7.1" ;
    aidgo:dqmlcStage aidgo:ProvisioningStage ;
    aidgo:inCollection iso5259:AidgoDataProvisioningReqColl ;
    aidgo:uses iso5259:dataProvenance,
        iso5259:dataProvisioning,
        iso5259:dataSpecificationDoc,
        iso5259:qualityRequirement .

iso5259:riskManagement a aidgo:Concept ;
    dct:identifier "riskManagement" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Coordinated activities to ensure all risks to data quality are accounted for, assessed and if necessary mitigated."@en ;
    skos:prefLabel "risk management (data quality)"@en ;
    aidgo:clauseNumber "3-rm" .

aidgo:ScopeOverlap a aidgo:AlignmentBasis ;
    skos:definition "The requirements overlap on part of their scope only."@en ;
    skos:inScheme aidgo:AlignmentBasisScheme ;
    skos:prefLabel "Scope overlap"@en .

aidgo:ToolManagementStage a aidgo:DQMLCStage ;
    skos:inScheme aidgo:DQMLCStageScheme ;
    skos:notation "10" ;
    skos:prefLabel "Management of data processing tools"@en .

iso5259:AidgoDataCollectionReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataCollectionReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataAcquisitionReqColl ;
    skos:definition "Requirements for documenting data collection."@en ;
    skos:prefLabel "Data collection"@en ;
    aidgo:clauseNumber "7.3.4.3" .

iso5259:AidgoDataProcessingToolsReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataProcessingToolsReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:prefLabel "Data processing tools"@en ;
    aidgo:clauseNumber "10" .

iso5259:AidgoPlanningReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoPlanningReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:prefLabel "Planning (DQM System)"@en ;
    aidgo:clauseNumber "6" .

aidgo:AlignmentType a owl:Class ;
    rdfs:label "Alignment type"@en ;
    rdfs:subClassOf skos:Concept .

aidgo:DecommissioningStage a aidgo:DQMLCStage ;
    skos:inScheme aidgo:DQMLCStageScheme ;
    skos:notation "7.3.8" ;
    skos:prefLabel "Data decommissioning"@en .

iso5259:AidgoDataQualityCultureReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataQualityCultureReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoPlanningReqColl ;
    skos:definition "Requirements for the organisation to establish and sustain a data quality culture."@en ;
    skos:prefLabel "Data quality culture"@en ;
    aidgo:clauseNumber "6.3.2" .

iso5259:AidgoReq_7_3_4_3 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_4_3" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall document: a) reasons for collection, including the relationship to the data specification; b) the method of data collection; c) the data collection specification including data item descriptions; d) required resources and skills for data collection; e) anonymisation or pseudonymisation methods where applicable; f) measurement scales and units; g) expected deviations from the data specification and their justification."@en ;
    skos:prefLabel "Data collection"@en ;
    aidgo:clauseNumber "7.3.4.3" ;
    aidgo:dqmlcStage aidgo:AcquisitionStage ;
    aidgo:inCollection iso5259:AidgoDataCollectionReqColl ;
    aidgo:uses iso5259:dataItem,
        iso5259:dataSpecificationDoc,
        iso5259:measurementScale .

iso5259:AidgoSupportReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoSupportReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:prefLabel "Support (DQMLC)"@en ;
    aidgo:clauseNumber "7" .

iso5259:dataLifeCycle a aidgo:Concept ;
    dct:identifier "dataLifeCycle" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:definition "All stages in the process of data usage from idea conception to its discontinuation."@en ;
    skos:prefLabel "data life cycle"@en ;
    aidgo:clauseNumber "3.1" .

iso5259:dataset a aidgo:Concept ;
    dct:identifier "dataset" ;
    dct:source "ISO/IEC 5259-2" ;
    skos:broader iso5259:data ;
    skos:definition "Collection of data with a shared format."@en ;
    skos:prefLabel "dataset"@en ;
    aidgo:clauseNumber "3.3" .

aidgo:AlignmentTypeScheme a skos:ConceptScheme ;
    dct:source "SKOS mapping properties; ISO 25964-2 equivalence types; SSSOM predicate model."@en ;
    skos:hasTopConcept aidgo:CompletelySatisfies,
        aidgo:ConflictsWith,
        aidgo:NoAlignment,
        aidgo:PartiallySatisfies,
        aidgo:RelatedTo ;
    skos:prefLabel "AIDGO alignment types"@en .

iso5259:AidgoDataCleaningReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataCleaningReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataPreprocessingReqColl ;
    skos:definition "Requirements for specifying and applying data cleaning measures."@en ;
    skos:prefLabel "Data cleaning"@en ;
    aidgo:clauseNumber "7.3.5.2" .

iso5259:AidgoReq_6_3_2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_6_3_2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization should sustain a data quality culture. The organization shall: a) have rules and processes to achieve quality (according to this document) taking into account the data quality model as applied to the applicable products and services; b) define and implement data quality management processes, and performing related data quality activities; c) integrate the data quality management processes and activities, to the extent appropriate, into other management processes and activities, such as general quality management and risk management; d) document the performed activities; e) provide resources sufficient to perform data quality management; f) monitor, and to the extent necessary, review and improve the data quality management processes; g) provide the required authority to involved personnel; h) communicate data quality policies within the organization."@en ;
    skos:prefLabel "Data quality culture"@en ;
    aidgo:clauseNumber "6.3.2" ;
    aidgo:dqmlcStage aidgo:OrganisationalStage ;
    aidgo:inCollection iso5259:AidgoDataQualityCultureReqColl ;
    aidgo:uses iso5259:dataQuality,
        iso5259:dataQualityManagement,
        iso5259:dataQualityModel,
        iso5259:riskManagement .

iso5259:AidgoReq_7_3_7_3 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_7_3" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Documentation provisioned with data shall include: a) scope of use and intended purpose; b) instructions for use; c) statistical properties of the dataset; d) description of each data item; e) list of stakeholders and their roles; f) duties and obligations of the recipient; g) use environment requirements; h) quality factors and their measurement results; i) acceptance test methods; j) communication strategy for updates and issue reporting."@en ;
    skos:prefLabel "Data provisioning documentation"@en ;
    aidgo:clauseNumber "7.3.7.3" ;
    aidgo:dqmlcStage aidgo:ProvisioningStage ;
    aidgo:inCollection iso5259:AidgoDataProvisioningDocReqColl ;
    aidgo:uses iso5259:dataItem,
        iso5259:dataProvisioning,
        iso5259:dataset,
        iso5259:measurement,
        iso5259:stakeholder .

iso5259:dataQualityCharacteristic a aidgo:Concept ;
    dct:identifier "dataQualityCharacteristic" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:broader iso5259:dataQuality ;
    skos:definition "Category of data quality attributes that bears on data quality."@en ;
    skos:prefLabel "data quality characteristic"@en ;
    aidgo:clauseNumber "3.5" .

iso5259:stakeholder a aidgo:Concept ;
    dct:identifier "stakeholder" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Person or organisation that can affect, be affected by, or perceive itself to be affected by a decision or activity related to data quality."@en ;
    skos:prefLabel "stakeholder"@en ;
    aidgo:clauseNumber "3-sh" .

aidgo:PreprocessingStage a aidgo:DQMLCStage ;
    skos:inScheme aidgo:DQMLCStageScheme ;
    skos:notation "7.3.5" ;
    skos:prefLabel "Data preprocessing"@en .

iso5259:AidgoDataFormatReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataFormatReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataSpecificationReqColl ;
    skos:definition "Requirements for specifying data format."@en ;
    skos:prefLabel "Data format"@en ;
    aidgo:clauseNumber "7.3.2.2" .

iso5259:AidgoDataProvisioningDocReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataProvisioningDocReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoDataProvisioningReqColl ;
    skos:definition "Requirements for documentation provisioned with data."@en ;
    skos:prefLabel "Data provisioning documentation"@en ;
    aidgo:clauseNumber "7.3.7.3" .

iso5259:dataProvisioning a aidgo:Concept ;
    dct:identifier "dataProvisioning" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:dataLifeCycle ;
    skos:definition "Process by which auditable data and metadata are delivered to users, meeting all specified requirements."@en ;
    skos:prefLabel "data provisioning"@en ;
    aidgo:clauseNumber "3-dprov" .

aidgo:PartiallyCovered a aidgo:CoverageStatus ;
    skos:inScheme aidgo:CoverageStatusScheme ;
    skos:prefLabel "Partially covered"@en .

aidgo:PlanningStage a aidgo:DQMLCStage ;
    skos:inScheme aidgo:DQMLCStageScheme ;
    skos:notation "7.3.3" ;
    skos:prefLabel "Data planning"@en .

iso5259:AidgoDataProvisioningReqColl a aidgo:RequirementCollection ;
    dct:identifier "AidgoDataProvisioningReqColl" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:broader iso5259:AidgoSupportReqColl ;
    skos:definition "Requirements for data provisioning processes."@en ;
    skos:prefLabel "Data provisioning General"@en ;
    aidgo:clauseNumber "7.3.7.1" .

iso5259:AidgoReq_7_3_2_2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_2_2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The data specification shall include: a) the data type(s) of each data item; b) the allowed range or set of values for each data item; c) the encoding and representation standards; d) the unit of measurement for quantitative data items; e) the definition of missing or null values; f) any required data structure (e.g. tabular, hierarchical, graph); g) inter-data constraints and integrity rules; h) metadata requirements; i) versioning and provenance requirements; j) any other format constraints relevant to intended use."@en ;
    skos:prefLabel "Data format specification"@en ;
    aidgo:clauseNumber "7.3.2.2" ;
    aidgo:dqmlcStage aidgo:SpecificationStage ;
    aidgo:inCollection iso5259:AidgoDataFormatReqColl ;
    aidgo:uses iso5259:dataItem,
        iso5259:dataProvenance,
        iso5259:dataSpecificationDoc,
        iso5259:dataType,
        iso5259:measurement,
        iso5259:metadata .

iso5259:dataQualityManagement a aidgo:Concept ;
    dct:identifier "dataQualityManagement" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:broader iso5259:dataQuality ;
    skos:definition "Coordinated activities to direct and control an organisation with regard to data quality."@en ;
    skos:prefLabel "data quality management"@en ;
    aidgo:clauseNumber "3.14" .

iso5259:AidgoReq_7_3_5_2 a aidgo:TechnicalRequirement,
        tair:Requirement ;
    dct:identifier "AidgoReq_7_3_5_2" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "The organization shall specify data quality measures to be applied for cleaning, including measures for: a) missing data items; b) duplication; c) outliers; d) bias and drift; e) non-standard or invalid data values; f) unneeded or irrelevant data items; g) required transformations; h) verification that cleaning results meet the data specification; i) de-identification or anonymisation where applicable."@en ;
    skos:prefLabel "Data cleaning"@en ;
    aidgo:clauseNumber "7.3.5.2" ;
    aidgo:dqmlcStage aidgo:PreprocessingStage ;
    aidgo:inCollection iso5259:AidgoDataCleaningReqColl ;
    aidgo:uses iso5259:dataItem,
        iso5259:dataQualityMeasure,
        iso5259:dataSpecificationDoc,
        iso5259:dataValue .

iso5259:dataQualityManagementLifeCycle a aidgo:Concept ;
    dct:identifier "dataQualityManagementLifeCycle" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:altLabel "DQMLC"@en ;
    skos:broader iso5259:dataLifeCycle ;
    skos:definition "Life cycle model providing guidance towards meeting quality requirements of data for analytics and ML with discrete stages for managing data quality."@en ;
    skos:prefLabel "data quality management life cycle"@en ;
    aidgo:clauseNumber "3-dqmlc" .

iso5259:dataQualityPlan a aidgo:Concept ;
    dct:identifier "dataQualityPlan" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Document covering processes, activities and resources required to meet the data specification throughout the data life cycle."@en ;
    skos:prefLabel "data quality plan"@en ;
    aidgo:clauseNumber "3-dqp" .

iso5259:qualityRequirement a aidgo:Concept ;
    dct:identifier "qualityRequirement" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:definition "Requirement for quality properties or attributes of a product, data or service."@en ;
    skos:prefLabel "quality requirement"@en ;
    aidgo:clauseNumber "3.8" .

aidgo:AcquisitionStage a aidgo:DQMLCStage ;
    skos:inScheme aidgo:DQMLCStageScheme ;
    skos:notation "7.3.4" ;
    skos:prefLabel "Data acquisition"@en .

aidgo:SpecificationStage a aidgo:DQMLCStage ;
    skos:inScheme aidgo:DQMLCStageScheme ;
    skos:notation "7.3.2" ;
    skos:prefLabel "Data specification"@en .

aidgo:DQMLCStageScheme a skos:ConceptScheme ;
    dct:source "ISO/IEC FDIS 5259-3, clauses 6-12"@en ;
    skos:prefLabel "ISO/IEC 5259-3 DQMLC stages"@en .

aidgo:DQMLCStage a owl:Class ;
    rdfs:label "Data quality management life cycle stage"@en ;
    rdfs:subClassOf skos:Concept .

iso5259:dataQualityMeasure a aidgo:Concept ;
    dct:identifier "dataQualityMeasure" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:broader iso5259:dataQualityCharacteristic ;
    skos:definition "Variable to which a value is assigned as the result of measurement of a data quality characteristic."@en ;
    skos:prefLabel "data quality measure"@en ;
    aidgo:clauseNumber "3.7" .

aidgo:PartiallySatisfies a aidgo:AlignmentType ;
    rdfs:seeAlso skos:broadMatch ;
    skos:definition "The technical requirement constrains at least one condition of the legal requirement but is not sufficient on its own; the residual is recorded in aidgo:alignmentGap."@en ;
    skos:inScheme aidgo:AlignmentTypeScheme ;
    skos:prefLabel "Partially satisfies"@en ;
    skos:scopeNote "R_iso constrains a condition of R_legal, and there exists S with Sat(S, R_iso), A and not Sat(S, R_legal)."@en ;
    skos:topConceptOf aidgo:AlignmentTypeScheme .

iso5259:dataItem a aidgo:Concept ;
    dct:identifier "dataItem" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:definition "Smallest identifiable unit of data within a certain context."@en ;
    skos:prefLabel "data item"@en ;
    aidgo:clauseNumber "3.20" .

aidgo:LegalRequirement a owl:Class ;
    rdfs:label "Legal requirement"@en ;
    rdfs:subClassOf tair:Requirement ;
    skos:definition "An atomic normative obligation extracted from a legal instrument (here: EU AI Act, Regulation (EU) 2024/1689, Article 10)."@en .

aidgo:ExpertValidated a aidgo:ValidationStatus ;
    skos:inScheme aidgo:ValidationStatusScheme ;
    skos:prefLabel "Expert validated"@en .

aidgo:MappingProcess_v2 a prov:Activity ;
    rdfs:label "AIDGO expert alignment of Article 10 to ISO/IEC 5259-3, v2"@en ;
    prov:startedAtTime "2026-04-14T00:00:00+00:00"^^xsd:dateTime ;
    prov:used aidgo:Source_EUAIAct_Art10,
        aidgo:Source_ISO5259_3 ;
    prov:wasAssociatedWith aidgo:KuruvillaGeorgeAiyankovil .

aidgo:KuruvillaGeorgeAiyankovil a prov:Person ;
    rdfs:label "Kuruvilla George Aiyankovil" .

iso5259:dataSpecificationDoc a aidgo:Concept ;
    dct:identifier "dataSpecificationDoc" ;
    dct:source "ISO/IEC 5259-3" ;
    skos:definition "Document specifying data requirements, validated to be consistent and complete for the intended use."@en ;
    skos:prefLabel "data specification"@en ;
    aidgo:clauseNumber "3-ds" .

aidgo:ProvisioningStage a aidgo:DQMLCStage ;
    skos:inScheme aidgo:DQMLCStageScheme ;
    skos:notation "7.3.7" ;
    skos:prefLabel "Data provisioning"@en .

aidgo:HorizontalProcessStage a aidgo:DQMLCStage ;
    skos:inScheme aidgo:DQMLCStageScheme ;
    skos:notation "8" ;
    skos:prefLabel "Horizontal processes"@en .

aidgo:AlignmentAssertion a owl:Class ;
    rdfs:label "Alignment assertion"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A first-class, provenance-bearing statement that a technical requirement stands in a typed alignment relation to a legal requirement."@en .

iso5259:dataQuality a aidgo:Concept ;
    dct:identifier "dataQuality" ;
    dct:source "ISO/IEC 5259-1" ;
    skos:definition "Degree to which a collection of characteristics of data fulfills requirements."@en ;
    skos:prefLabel "data quality"@en ;
    aidgo:clauseNumber "3.4" .

aidgo:OrganisationalStage a aidgo:DQMLCStage ;
    skos:inScheme aidgo:DQMLCStageScheme ;
    skos:notation "6" ;
    skos:prefLabel "Overall data quality management"@en .

aidgo:RequirementCollection a owl:Class ;
    rdfs:label "Requirement collection"@en ;
    rdfs:subClassOf oslc_rm:RequirementCollection ;
    skos:definition "A clause-level grouping of requirements that mirrors the structure of the source document."@en .

aidgo:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A term defined in the terms-and-definitions clause of an ISO/IEC 5259 part."@en .

aidgo:ConjunctiveRequirement a owl:Class ;
    rdfs:label "Conjunctive requirement"@en ;
    rdfs:subClassOf aidgo:TechnicalRequirement,
        tair:ConjuntiveRequirement ;
    skos:definition "An atomic requirement obtained by bracket-context decomposition of a compound requirement: the shared lead-in is kept in square brackets and each list item becomes one conjunct."@en .

tair:ConjuntiveRequirement a owl:Class ;
    rdfs:label "Conjunctive requirement (TAIR)"@en ;
    rdfs:comment "IRI spelled as published by TAIR (missing 't'). AIDGO reuses it unchanged for interoperability and provides the correctly spelled aidgo:ConjunctiveRequirement (ISO-side atomic requirements) as a subclass."@en ;
    rdfs:isDefinedBy <https://w3id.org/tair> ;
    rdfs:subClassOf tair:Requirement .

aidgo:TechnicalRequirement a owl:Class ;
    rdfs:label "Technical requirement"@en ;
    rdfs:subClassOf tair:Requirement ;
    skos:definition "A normative (SHALL) requirement extracted from a technical standard (here: ISO/IEC 5259-3)."@en .

tair:Requirement a owl:Class ;
    rdfs:label "Requirement (TAIR)"@en ;
    rdfs:isDefinedBy <https://w3id.org/tair> .


<https://w3id.org/aidgo> a owl:Ontology ;
    dct:contributor "David Lewis" ;
    dct:created "2024-06-01"^^xsd:date ;
    dct:creator "Kuruvilla George Aiyankovil" ;
    dct:description """An OWL 2 ontology for representing, querying and auditing the alignment
between legal data-governance obligations (EU AI Act, Article 10) and technical data-quality
requirements (ISO/IEC 5259 series). Each alignment is a first-class AlignmentAssertion typed by
one of five alignment types and one of five alignment bases, justified in natural language and
carrying PROV-O provenance. An RDF-star annotation layer (aidgo_kg_star.ttl) mirrors every
assertion as an annotated triple for SPARQL-star queries."""@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-10-26"^^xsd:date ;
    dct:publisher "ADAPT Centre, Trinity College Dublin" ;
    dct:references <https://eur-lex.europa.eu/eli/reg/2024/1689/oj>,
        "ISO/IEC 5259 series, Parts 1-5: Artificial intelligence - Data quality for analytics and machine learning (ML)" ;
    dct:title "AIDGO: AI Data Governance Ontology"@en ;
    vann:preferredNamespacePrefix "aidgo" ;
    vann:preferredNamespaceUri "https://w3id.org/aidgo#" ;
    rdfs:seeAlso <https://github.com/aiyankovil/AIDGO> ;
    owl:versionIRI <https://w3id.org/aidgo/2.0.0> ;
    owl:versionInfo "2.0.0" .

aidgo:AgentGenerated a aidgo:ValidationStatus ;
    skos:inScheme aidgo:ValidationStatusScheme ;
    skos:prefLabel "Agent generated (unvalidated)"@en .

aidgo:DefinitionDifference a aidgo:AlignmentType ;
    dct:isReplacedBy aidgo:PartiallySatisfies ;
    rdfs:comment "A v1 type. In v2.0 definitional divergence is recorded as a PartiallySatisfies assertion with basis aidgo:ScopeOverlap or aidgo:ConceptualCoverage."@en ;
    owl:deprecated true ;
    skos:prefLabel "Definition difference (deprecated)"@en .

aidgo:LexicalConceptLinking_v1 a prov:Activity ;
    rdfs:label "Deterministic longest-match lexical linking of requirement text to ISO/IEC 5259 concept labels"@en ;
    prov:used aidgo:Source_ISO5259_3 .


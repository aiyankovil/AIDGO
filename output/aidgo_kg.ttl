aidgo:alignedWith a owl:ObjectProperty ;
    rdfs:label "aligned with"@en ;
    rdfs:comment "Shortcut legal -> technical edge. Used as the annotated triple in the RDF-star layer; each occurrence is reified by exactly one aidgo:AlignmentAssertion."@en ;
    rdfs:domain aidgo:LegalRequirement ;
    rdfs:range aidgo:TechnicalRequirement .

aidgo:alignmentBasis a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "alignment basis"@en ;
    rdfs:domain aidgo:AlignmentAssertion ;
    rdfs:range aidgo:AlignmentBasis .

aidgo:alignmentGap a owl:DatatypeProperty ;
    rdfs:label "alignment gap"@en ;
    rdfs:comment "What the technical requirement leaves unaddressed relative to the legal requirement."@en ;
    rdfs:domain aidgo:AlignmentAssertion .

aidgo:alignmentJustification a owl:DatatypeProperty ;
    rdfs:label "alignment justification"@en ;
    rdfs:domain aidgo:AlignmentAssertion .

aidgo:alignmentType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "alignment type"@en ;
    rdfs:domain aidgo:AlignmentAssertion ;
    rdfs:range aidgo:AlignmentType .

aidgo:articleReference a owl:DatatypeProperty ;
    rdfs:label "article reference"@en ;
    rdfs:domain aidgo:LegalRequirement ;
    rdfs:range xsd:string .

aidgo:clauseNumber a owl:DatatypeProperty ;
    rdfs:label "clause number"@en ;
    rdfs:comment "Clause number in the source document (ISO/IEC FDIS numbering)."@en ;
    rdfs:range xsd:string .

aidgo:conflictDescription a owl:DatatypeProperty ;
    rdfs:label "conflict description"@en ;
    rdfs:domain aidgo:AlignmentAssertion .

aidgo:coverageStatus a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "coverage status"@en ;
    rdfs:comment "Materialised by the aggregation rule documented on aidgo:CoverageStatusScheme; re-derivable with queries/CQ-COV.rq."@en ;
    rdfs:domain aidgo:LegalRequirement ;
    rdfs:range aidgo:CoverageStatus .

aidgo:coveredCQs a owl:DatatypeProperty ;
    rdfs:label "covered competency questions"@en ;
    rdfs:domain aidgo:AlignmentAssertion ;
    rdfs:range xsd:string .

aidgo:dqmlcStage a owl:ObjectProperty ;
    rdfs:label "DQMLC stage"@en ;
    rdfs:range aidgo:DQMLCStage .

aidgo:inCollection a owl:ObjectProperty ;
    rdfs:label "in collection"@en ;
    rdfs:comment "Membership of a requirement in a clause-level collection (not a SKOS hierarchy relation)."@en ;
    rdfs:domain tair:Requirement ;
    rdfs:range aidgo:RequirementCollection .

aidgo:legalFocus a owl:DatatypeProperty ;
    rdfs:label "legal focus"@en ;
    rdfs:comment "When an assertion targets one element of a legal requirement (e.g. only 'enrichment and aggregation' within Art. 10(2)(c)), the element it targets. The alignment type is judged against this focus, not the whole obligation."@en ;
    rdfs:domain aidgo:AlignmentAssertion .

aidgo:legalFocusText a owl:DatatypeProperty ;
    rdfs:label "legal focus text"@en ;
    rdfs:comment "Wording of the element of the legal requirement named by aidgo:legalFocus."@en ;
    rdfs:domain aidgo:AlignmentAssertion .

aidgo:legalRequirement a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "legal requirement"@en ;
    rdfs:domain aidgo:AlignmentAssertion ;
    rdfs:range aidgo:LegalRequirement .

aidgo:technicalRequirement a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "technical requirement"@en ;
    rdfs:comment "The aligned technical requirement, or rdf:nil for an aidgo:NoAlignment assertion. No rdfs:range is declared because rdf:nil is not a requirement; the SHACL shapes enforce the disjunction."@en ;
    rdfs:domain aidgo:AlignmentAssertion .

aidgo:uses a owl:ObjectProperty ;
    rdfs:label "uses"@en ;
    rdfs:comment "A requirement whose text employs a defined concept. In v2.0 these links are derived by deterministic lexical matching (prov:wasGeneratedBy aidgo:LexicalConceptLinking_v1) and are not expert-validated."@en ;
    rdfs:domain tair:Requirement ;
    rdfs:range aidgo:Concept .

aidgo:validationStatus a owl:ObjectProperty ;
    rdfs:label "validation status"@en ;
    rdfs:domain aidgo:AlignmentAssertion ;
    rdfs:range aidgo:ValidationStatus .


# CQ-STAR (SPARQL 1.2 / SPARQL-star): query the alignment layer through the annotated triples.
# Each assertion node is the reifier of  legal aidgo:alignedWith technical .
# Requires output/aidgo_kg_star.ttl and a SPARQL 1.2 engine (Oxigraph >= 0.5, Jena >= 5).
PREFIX aidgo: <https://w3id.org/aidgo#>
PREFIX iso5259: <https://w3id.org/aidgo/iso5259#>
PREFIX aiapr: <https://w3id.org/euaiact/art10#>
PREFIX tair: <https://w3id.org/tair#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?legalReqID ?techReqID ?alignmentType ?basis ?assertion WHERE {
  ?lr aidgo:alignedWith ?tr ~ ?assertion {| aidgo:alignmentType ?alignmentType ;
                                             aidgo:alignmentBasis ?basis |} .
  ?lr dct:identifier ?legalReqID .
  ?tr dct:identifier ?techReqID .
} ORDER BY ?legalReqID ?techReqID

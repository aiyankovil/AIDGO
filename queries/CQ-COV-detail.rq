# CQ-COV (detail): coverage status of every Article 10 obligation with its assertion counts.
PREFIX aidgo: <https://w3id.org/aidgo#>
PREFIX iso5259: <https://w3id.org/aidgo/iso5259#>
PREFIX aiapr: <https://w3id.org/euaiact/art10#>
PREFIX tair: <https://w3id.org/tair#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?legalReqID ?articleRef ?status (COUNT(?m) AS ?assertions)
       (GROUP_CONCAT(DISTINCT STRAFTER(STR(?t), "#"); separator=", ") AS ?types) WHERE {
  ?lr a aidgo:LegalRequirement ; dct:identifier ?legalReqID ; aidgo:articleReference ?articleRef ;
      aidgo:coverageStatus ?status .
  ?m aidgo:legalRequirement ?lr ; aidgo:alignmentType ?t .
} GROUP BY ?legalReqID ?articleRef ?status ORDER BY ?legalReqID

# CQ-COV: Obligation-level coverage, re-derived from the assertions (not from the materialised
#         aidgo:coverageStatus). Rule: FullyCovered iff every assertion is CompletelySatisfies;
#         NotCovered iff every assertion is NoAlignment; PartiallyCovered otherwise.
PREFIX aidgo: <https://w3id.org/aidgo#>
PREFIX iso5259: <https://w3id.org/aidgo/iso5259#>
PREFIX aiapr: <https://w3id.org/euaiact/art10#>
PREFIX tair: <https://w3id.org/tair#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?status (COUNT(?lr) AS ?obligations) WHERE {
  { SELECT ?lr (COUNT(?m) AS ?n)
           (SUM(IF(?t = aidgo:CompletelySatisfies, 1, 0)) AS ?cs)
           (SUM(IF(?t = aidgo:NoAlignment, 1, 0)) AS ?na) WHERE {
      ?lr a aidgo:LegalRequirement .
      OPTIONAL { ?m aidgo:legalRequirement ?lr ; aidgo:alignmentType ?t }
    } GROUP BY ?lr }
  BIND(IF(?n = 0, "Unassessed",
       IF(?cs = ?n, "FullyCovered",
       IF(?na = ?n, "NotCovered", "PartiallyCovered"))) AS ?status)
} GROUP BY ?status ORDER BY ?status
